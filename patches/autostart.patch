+		float ax = 0, ay = 0;
+		ps4_pad_state(b, ax, ay);
+		if (autoSince < 0.f)
+		{
+			autoSince = gTime;
+			autoPrev = b;	// a button still held from skipping the opening isn't a cancel
+		}
+		const bool cancel = (b & ~autoPrev) != 0;
+		autoPrev = b;
+		int found = -1;
+		for (int i = 0; i < (int)gGames.size(); i++)
+			if (gGames[i].e.path == wanted)
+				found = i;
+		if (wanted.empty() || cancel || gTime - autoSince > 15.f)
+			autoDone = true;	// nothing chosen, cancelled, or the game never showed up (share offline)
+		else if (found >= 0 && autoStartAt < 0.f)
