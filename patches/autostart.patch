+// Auto-Start Game: the started game's loading shows black only (no cover, label or progress bar)
+static bool gQuietLoad;
+
+// the start animation is over (or Auto-Start skips it): boot the game, Flycast shows its loading screen
+static void bootGame(const Game& g)
+{
+	char line[600];
+	snprintf(line, sizeof(line), "launcher: starting %s", g.e.path.c_str());
+	ps4_boot_trace(line);
+	soundStop();
+	currentGameCover = g.cover;
+	currentGameDiscs = g.e.discs;
+	gLaunched = g;
+	gLaunchedPixels.clear();
+	if (FILE *cf = g.cover.empty() ? nullptr : nowide::fopen(g.cover.c_str(), "rb"))
+	{
+		int n;
+		if (u8 *data = stbi_load_from_file(cf, &gLaunchedW, &gLaunchedH, &n, 4))
+		{
+			gLaunchedPixels.assign(data, data + (size_t)gLaunchedW * gLaunchedH * 4);
+			stbi_image_free(data);
+		}
+		fclose(cf);
+	}
+	gui_ps4_start_game(g.e.path, g.e.title);
+}
