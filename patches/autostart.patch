+}
+
+static const char *const kAutoStartFile = "/data/Resonance/autostart.txt";
+
+std::string autoStartPath()
+{
+	std::string path;
+	if (FILE *f = nowide::fopen(kAutoStartFile, "rb"))
+	{
+		char buf[2048];
+		const size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+		fclose(f);
+		path.assign(buf, n);
+		while (!path.empty() && (path.back() == '\n' || path.back() == '\r' || path.back() == ' '))
+			path.pop_back();
+	}
+	return path;
+}
+
+void setAutoStartPath(const std::string& path)
+{
+	if (FILE *f = nowide::fopen(kAutoStartFile, "wb"))
+	{
+		fwrite(path.data(), 1, path.size(), f);
+		fclose(f);
+	}
 }
 
