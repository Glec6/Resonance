 		L(exit_block);
 		add(rsp, STACK_ALIGN);
+#ifdef __ORBIS__
+		// Tail dispatch: while the time slice lasts (and without the MMU), jump straight to the
+		// next block through the FPCB table instead of returning to the main loop. The stack is
+		// as the main loop's call left it, so the next block (or ngen_FailedToFindBlock) runs
+		// exactly as if called from there, and its ret goes back to the main loop. One indirect
+		// jump per block end predicts far better on the PS4's Jaguar cores than the main loop's
+		// single shared call.
+		{
+			Xbyak::Label toMainloop;
+			mov(rax, (uintptr_t)&sh4ctx.cycle_counter);
+			cmp(dword[rax], 0);
+			jle(toMainloop);
+			mov(rax, (size_t)&mmuOn);
+			cmp(byte[rax], 0);
+			jne(toMainloop);
+			mov(rax, (size_t)&sh4ctx.pc);
+			mov(edx, dword[rax]);
+			and_(edx, FPCB_MASK << 1);
+			mov(rax, (size_t)&p_sh4rcb);
+			mov(rax, qword[rax]);
+			jmp(qword[rax + rdx * 4]);
+			L(toMainloop);
+		}
+#endif
 		ret();
 
 		ready();
@@ -700,7 +724,29 @@ public:
 		L(slice_loop);
 		mov(rax, (size_t)&sh4ctx.pc);
 		mov(call_regs[0], dword[rax]);
+#ifdef __ORBIS__
+		// The next block's code from the FPCB table, inline: without the MMU that is all
+		// bm_GetCodeByVAddr does, but as a call it saved and restored six registers around one
+		// load, and on the PS4's Jaguar cores the lookup cost ~30% of the emulation thread
+		// (DeCast-S4 profile). With the MMU on, the C++ lookup as before.
+		{
+			Xbyak::Label slowLookup, haveCode;
+			mov(rax, (size_t)&mmuOn);
+			cmp(byte[rax], 0);
+			jne(slowLookup, T_NEAR);
+			mov(rax, (size_t)&p_sh4rcb);
+			mov(rax, qword[rax]);		// fpcb is the first member of Sh4RCB
+			mov(edx, call_regs[0]);
+			and_(edx, FPCB_MASK << 1);
+			mov(rax, qword[rax + rdx * 4]);	// fpcb[(pc >> 1) & FPCB_MASK]
