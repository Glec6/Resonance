+void VulkanContext::SavePipelineCache()
+{
+	if (!device || !pipelineCache)
+		return;
+	std::vector<u8> cacheData = device->getPipelineCacheData(*pipelineCache);
+	if (cacheData.empty())
+		return;
+	std::string cachePath = hostfs::getShaderCachePath("vulkan_pipeline.cache");
+	// written aside and renamed: a power cut (or the app being closed) never leaves half a file
+	std::string tmpPath = cachePath + ".tmp";
+	FILE *f = nowide::fopen(tmpPath.c_str(), "wb");
+	if (f == nullptr)
+		return;
+	bool ok = std::fwrite(&cacheData[0], 1, cacheData.size(), f) == cacheData.size();
+	std::fclose(f);
+	if (ok)
+		ok = nowide::rename(tmpPath.c_str(), cachePath.c_str()) == 0;
+	if (!ok)
+		nowide::remove(tmpPath.c_str());
+	else
+		INFO_LOG(RENDERER, "Saved the pipeline cache (%zu bytes)", cacheData.size());
+}
+
