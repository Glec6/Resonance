+#include "launcher_internal.h"
+#include "ui/IconsFontAwesome6.h"
+
+#include <algorithm>
+#include <ctime>
+
+namespace launcher
+{
+namespace
+{
+
+enum Category { SETTINGS, THEMES, GAMES, CATEGORY_COUNT };
+const char *const kCategoryIcon[CATEGORY_COUNT] = { ICON_FA_GEAR, ICON_FA_PALETTE, ICON_FA_GAMEPAD };
+const char *const kCategoryName[CATEGORY_COUNT] = { "Settings", "Themes", "Games" };
+const char *const kThemeBlurb[THEME_COUNT] = {
+	"Discs on a turning ring", "Every game is a TV channel", "Box art on a glossy shelf", "This menu",
+};
+
+class CrossBar : public Theme
+{
+public:
+	const char *name() const override { return "Cross bar"; }
+	float launchSeconds() const override { return 1.2f; }
+
+	bool navigate(Frame& f, int dx, int dy) override
+	{
+		if (dx != 0)
+		{
+			const int next = std::clamp(cat + dx, 0, CATEGORY_COUNT - 1);
+			if (next != cat)
+			{
+				cat = next;
+				catChangedAt = f.t;
+				playSound(Sound::Category);
+			}
+			return true;
+		}
+		if (cat == GAMES)
+		{
+			moveSelection(dy);
+			return true;
+		}
+		const int count = itemCount(f);
+		const int next = std::clamp(item[cat] + dy, 0, count - 1);
+		if (next != item[cat])
+		{
+			item[cat] = next;
+			itemChangedAt = f.t;
+			playSound(Sound::Move);
+		}
+		return true;
+	}
+
+	bool activate(Frame& f) override
+	{
+		switch (cat)
+		{
+		case GAMES:
+			return false;	// the core starts the game
+		case THEMES:
+			if (item[THEMES] == currentTheme())
+				playSound(Sound::Confirm);
+			else
+				requestTheme(item[THEMES]);
+			return true;
+		default:
+			if (item[SETTINGS] == 0)
+				openSettings();
+			else
+				playSound(Sound::Error);	// the covers folder: information only
+			return true;
+		}
+	}
+
+	void draw(Frame& f) override
+	{
+		std::vector<Game>& games = *f.games;
+		const int n = (int)games.size();
+		if (!started)
+		{
+			started = true;
+			catPos = (float)cat;
+			item[THEMES] = currentTheme();
+			for (int c = 0; c < CATEGORY_COUNT; c++)
+				itemPos[c] = c == GAMES ? (float)f.goal : (float)item[c];
+		}
+		const float launch = f.launchAt >= 0 ? clamp01((f.t - f.launchAt) / launchSeconds()) : 0.f;
+		spring(catPos, catVel, (float)cat, 110.f, 21.f, f.dt);
+		for (int c = 0; c < CATEGORY_COUNT; c++)
+			spring(itemPos[c], itemVel[c], c == GAMES ? (float)f.goal : (float)item[c], 130.f, 23.f, f.dt);
+
+		// the colour of the moment: the selected game's on the Games row, deep blue elsewhere
+		const Color want1 = cat == GAMES && n > 0 ? games[f.sel].c1 : Color { .3f, .5f, 1.f };
+		const Color want2 = cat == GAMES && n > 0 ? games[f.sel].c2 : Color { .03f, .06f, .16f };
+		approach(tone1, want1, 2.2f, f.dt);
+		approach(tone2, want2, 2.2f, f.dt);
+
+		drawBackdrop(f);
+		const float ui = 1 - easeOut(launch / .35f);
+		drawCategories(f, ui);
+		drawItems(f, ui, launch);
+		drawClock(f, ui);
+		drawHints(f, ui);
+		if (launch > .7f)
+			f.dl->AddRectFilled(ImVec2(0, 0), ImVec2(f.w, f.h), IM_COL32(0, 0, 0, (int)(255 * clamp01((launch - .7f) / .3f))));
+	}
+
+private:
+	int itemCount(const Frame& f) const
+	{
+		switch (cat)
+		{
+		case GAMES: return std::max(1, (int)f.games->size());
+		case THEMES: return THEME_COUNT;
+		default: return 2;
+		}
+	}
+
+	// Gradient sky and three ribbons of light, each a soft-edged strip that breathes
+	void drawBackdrop(Frame& f)
+	{
+		ImDrawList *dl = f.dl;
+		const Color top = mix(tone2, { 0, 0, 0 }, .15f), bottom = mix(tone2, tone1, .22f);
+		dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(f.w, f.h), top.u32(), top.u32(), bottom.u32(), bottom.u32());
+		drawBlob(dl, ImVec2(f.w * .8f, f.h * .2f), f.h * .9f, tone1.u32(.10f));
+
+		constexpr int COLS = 96;
+		for (int r = 0; r < 3; r++)
+		{
+			const float base = f.h * (.6f + .06f * r);
+			const float amp = f.h * (.07f - .015f * r), speed = .22f + .09f * r, freq = 1.6f + .5f * r;
+			const float thick = f.h * (.05f + .025f * std::sin(f.t * .3f + r));
+			const Color c = mix(tone1, { 1, 1, 1 }, .35f + .15f * r);
+			const float peak = .20f - .045f * r;
+			ImVec2 mid[COLS + 1];
+			float width[COLS + 1];
+			for (int i = 0; i <= COLS; i++)
+			{
+				const float x = (float)i / COLS;
+				const float y = base + amp * std::sin(x * freq * PI + f.t * speed + r * 1.7f)
+						+ amp * .45f * std::sin(x * freq * 2.3f * PI - f.t * speed * 1.4f + r);
+				mid[i] = ImVec2(x * f.w, y);
+				// the ribbon twists: thin where it turns over
+				width[i] = thick * (.25f + .75f * std::fabs(std::cos(x * 2.4f * PI + f.t * speed * .8f + r * 2.2f)));
+			}
+			const ImVec2 white = whiteUV(dl);
+			// two halves: clear at the edges, bright along the middle
+			dl->PrimReserve(COLS * 12, (COLS + 1) * 3);
+			const u32 v0 = dl->_VtxCurrentIdx;
+			for (int i = 0; i <= COLS; i++)
+			{
+				const float edgeFade = clamp01(std::min(i, COLS - i) / 10.f);
+				dl->PrimWriteVtx(ImVec2(mid[i].x, mid[i].y - width[i]), white, c.u32(0));
+				dl->PrimWriteVtx(mid[i], white, c.u32(peak * edgeFade * (.6f + .4f * width[i] / thick)));
+				dl->PrimWriteVtx(ImVec2(mid[i].x, mid[i].y + width[i] * .6f), white, c.u32(0));
+			}
+			for (int i = 0; i < COLS; i++)
+			{
+				const ImDrawIdx a = (ImDrawIdx)(v0 + i * 3), b = (ImDrawIdx)(v0 + (i + 1) * 3);
+				dl->PrimWriteIdx(a); dl->PrimWriteIdx(b); dl->PrimWriteIdx(b + 1);
+				dl->PrimWriteIdx(a); dl->PrimWriteIdx(b + 1); dl->PrimWriteIdx(a + 1);
+				dl->PrimWriteIdx(a + 1); dl->PrimWriteIdx(b + 1); dl->PrimWriteIdx(b + 2);
+				dl->PrimWriteIdx(a + 1); dl->PrimWriteIdx(b + 2); dl->PrimWriteIdx(a + 2);
+			}
+			// sparks riding the ribbon
+			for (int s = 0; s < 6; s++)
+			{
+				const float u = std::fmod(s / 6.f + f.t * (.012f + .004f * s) + r * .13f, 1.f);
+				const int i = (int)(u * COLS);
+				const float tw = .5f + .5f * std::sin(f.t * 2.f + s * 1.3f + r);
+				drawBlob(dl, mid[i], f.h * .012f * (1 + tw), IM_COL32(255, 255, 255, (int)(90 * tw)));
+			}
+		}
+	}
+
+	ImVec2 barOrigin(const Frame& f) const {
+		return ImVec2(f.w * .26f, f.h * .26f);
+	}
+
+	void drawCategories(Frame& f, float alpha)
+	{
+		const ImVec2 o = barOrigin(f);
+		const float step = f.w * .13f;
+		ImFont *icons = bodyFont();
+		for (int c = 0; c < CATEGORY_COUNT; c++)
+		{
+			const float k = c - catPos;
+			const float near = clamp01(1 - std::fabs(k));
+			const float x = o.x + k * step;
+			const float size = f.h * (.055f + .025f * near);
+			const float a = alpha * (.45f + .55f * near);
+			// glow under the current category
+			if (near > .01f)
+				drawBlob(f.dl, ImVec2(x, o.y), size * 1.6f, tone1.u32(.35f * near * alpha));
+			drawText(f.dl, icons, size, ImVec2(x, o.y - size * .55f), IM_COL32(255, 255, 255, (int)(255 * a)), kCategoryIcon[c], .5f);
+			if (near > .01f)
+			{
+				const float e = easeOut((f.t - catChangedAt) / .3f);
+				drawText(f.dl, displayFont(), f.h * .022f, ImVec2(x, o.y + size * .65f + (1 - e) * 6), IM_COL32(255, 255, 255, (int)(255 * near * e * alpha)),
+						kCategoryName[c], .5f);
+			}
+		}
+	}
+
+	// The column under the current category: the selected item just below the bar, earlier ones above it
+	void drawItems(Frame& f, float alpha, float launch)
+	{
+		const ImVec2 o = barOrigin(f);
+		const float step = f.w * .13f;
+		for (int c = 0; c < CATEGORY_COUNT; c++)
+		{
+			const float k = c - catPos;
+			const float colAlpha = clamp01(1 - std::fabs(k) * 1.6f);
+			if (colAlpha <= 0)
+				continue;
+			const float x = o.x + k * step;
+			const int count = c == GAMES ? (int)f.games->size() : c == THEMES ? THEME_COUNT : 2;
+			if (count == 0)
+			{
+				drawText(f.dl, displayFont(), f.h * .03f, ImVec2(x - f.h * .04f, o.y + f.h * .13f), IM_COL32(255, 255, 255, (int)(230 * colAlpha * alpha)),
+						"No games yet");
+				drawText(f.dl, bodyFont(), f.h * .022f, ImVec2(x - f.h * .04f, o.y + f.h * .18f), IM_COL32(200, 205, 220, (int)(200 * colAlpha * alpha)),
+						"Copy games to /data/DeCast-S4/games");
+				continue;
+			}
+			const int selected = c == GAMES ? f.goal : item[c];
+			for (int i = (int)std::floor(itemPos[c]) - 4; i <= (int)std::ceil(itemPos[c]) + 7; i++)
+			{
+				if (c != GAMES && (i < 0 || i >= count))
+					continue;
+				if (c == GAMES && count < 12 && (i - selected > count - 1 - 3 || selected - i > 3))
+					continue;	// a short library: no repeats on screen
+				const float d = i - itemPos[c];
+				const bool isSel = i == selected;
+				const float near = clamp01(1 - std::fabs(d));
+				// below the bar for the selected and later items, above it for earlier ones
+				const float below = o.y + f.h * .14f, above = o.y - f.h * .1f;
+				float y;
+				if (d >= 0)
+					y = below + d * f.h * .11f;
+				else if (d <= -1)
+					y = above + (d + 1) * f.h * .09f;
+				else
+					y = below + (above - below) * -d;	// passing the bar
+				const float fade = clamp01(1.4f - std::fabs(d) * .22f) * colAlpha;
+				float a = fade * (isSel ? 1.f : .62f);
+				if (isSel && launch > 0)
+					a = 1.f;
+				else
+					a *= alpha;
+				if (a <= .01f)
+					continue;
+				drawItem(f, c, ((i % count) + count) % count, ImVec2(x, y), near * colAlpha, a, isSel ? launch : 0.f);
+			}
+		}
+	}
+
+	void drawItem(Frame& f, int c, int index, ImVec2 p, float focus, float alpha, float launch)
+	{
+		ImDrawList *dl = f.dl;
+		const float iconSize = f.h * (.075f + .045f * focus) * (1 + launch * 1.5f);
+		const ImVec2 i0(p.x - iconSize / 2, p.y - iconSize / 2), i1(p.x + iconSize / 2, p.y + iconSize / 2);
+		std::string title, detail;
+		if (c == GAMES)
+		{
+			const Game& g = (*f.games)[index];
+			if (focus > .01f)
+			{
+				// a breathing halo around the focused game
+				const float pulse = .5f + .5f * std::sin(f.t * 2.4f);
+				drawBlob(dl, p, iconSize * (1.1f + .1f * pulse), g.c1.u32(.4f * focus * alpha));
+			}
+			const ImTextureID tex = coverTexture(g);
+			if (tex != ImTextureID())
+				dl->AddImageRounded(tex, i0, i1, ImVec2(0, 0), ImVec2(1, 1), IM_COL32(255, 255, 255, (int)(255 * alpha)), iconSize * .06f);
+			else
+			{
+				dl->AddRectFilledMultiColor(i0, i1, g.c1.u32(alpha), g.c2.u32(alpha), g.c2.u32(alpha), g.c1.u32(alpha));
+				drawText(dl, bodyFont(), iconSize * .4f, ImVec2(p.x, p.y - iconSize * .22f), IM_COL32(255, 255, 255, (int)(200 * alpha)), ICON_FA_COMPACT_DISC, .5f);
+			}
+			dl->AddRect(i0, i1, IM_COL32(255, 255, 255, (int)(110 * focus * alpha)), iconSize * .06f, 0, 1.5f);
+			title = g.e.title;
+			detail = g.format;
+			if (!g.regionName.empty())
+				detail += "   \xC2\xB7   " + g.regionName;
+			if (!g.e.productId.empty())
+				detail += "   \xC2\xB7   " + g.e.productId;
+		}
+		else
+		{
+			const char *icon;
+			if (c == THEMES)
+			{
+				icon = index == currentTheme() ? ICON_FA_CHECK : index == 0 ? ICON_FA_COMPACT_DISC : index == 1 ? ICON_FA_TV
+						: index == 2 ? ICON_FA_LAYER_GROUP : ICON_FA_BARS;
+				title = themeName(index);
+				detail = kThemeBlurb[index];
+			}
+			else
+			{
+				icon = index == 0 ? ICON_FA_SLIDERS : ICON_FA_IMAGE;
+				title = index == 0 ? "Emulator settings" : "Covers";
+				detail = index == 0 ? "Video, audio, controls, BIOS, content folders"
+						: "Your own: /data/DeCast-S4/covers/<game file or serial>.png";
+			}
+			drawText(dl, bodyFont(), iconSize * .6f, ImVec2(p.x, p.y - iconSize * .33f), IM_COL32(255, 255, 255, (int)(255 * alpha)), icon, .5f);
+		}
+		if (launch > 0)
+			return;
+		const float tx = p.x + f.h * .1f;
+		const float ts = f.h * (.026f + .01f * focus);
+		drawText(dl, focus > .5f ? displayFont() : bodyFont(), ts, ImVec2(tx, p.y - ts * (.55f + .45f * focus)), IM_COL32(255, 255, 255, (int)(255 * alpha)),
+				title, 0, f.w * .95f - tx);
+		if (focus > .01f)
+		{
+			const float e = easeOut((f.t - std::max(f.selectedAt, itemChangedAt)) / .35f) * focus;
+			drawText(dl, bodyFont(), f.h * .022f, ImVec2(tx + (1 - e) * 10, p.y + ts * .45f), mix(tone1, { 1, 1, 1 }, .55f).u32(alpha * e),
+					detail, 0, f.w * .95f - tx);
+		}
+	}
+
+	void drawClock(Frame& f, float alpha)
+	{
+		char clock[32], date[32];
+		const time_t now = time(nullptr);
+		const tm *lt = localtime(&now);
+		strftime(clock, sizeof(clock), "%H:%M", lt);
+		strftime(date, sizeof(date), "%d/%m", lt);
+		const float x = f.w * .95f, y = f.h * .06f;
+		const float tw = drawText(f.dl, displayFont(), f.h * .03f, ImVec2(x, y), IM_COL32(255, 255, 255, (int)(235 * alpha)), clock, 1.f);
+		drawText(f.dl, bodyFont(), f.h * .024f, ImVec2(x - tw - f.h * .02f, y + f.h * .004f), IM_COL32(220, 225, 235, (int)(180 * alpha)), date, 1.f);
+	}
+
+	bool started = false;
+	int cat = GAMES;
+	int item[CATEGORY_COUNT] {};
+	float catPos = GAMES, catVel = 0;
+	float itemPos[CATEGORY_COUNT] {}, itemVel[CATEGORY_COUNT] {};
+	float catChangedAt = -10.f, itemChangedAt = -10.f;
+	Color tone1 { .3f, .5f, 1.f }, tone2 { .03f, .06f, .16f };
+};
+
+} // namespace
+
+std::unique_ptr<Theme> makeCrossBar() {
+	return std::make_unique<CrossBar>();
+}
