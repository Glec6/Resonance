+
+// Input codes: buttons are the ScePad button bits, axes are numbered here.
+namespace ps4pad
+{
+enum : u32
+{
+	AXIS_LX = 0,
+	AXIS_LY,
+	AXIS_RX,
+	AXIS_RY,
+	AXIS_L2,
+	AXIS_R2,
+	AXIS_COUNT,
+	// touchpad click by half (left: the menu; right: free to map)
+	BTN_TOUCH_LEFT = 0x200000,
+	BTN_TOUCH_RIGHT = 0x400000,
+};
+}
+
+class PS4Gamepad : public GamepadDevice
+{
+public:
+	PS4Gamepad(int maple_port, int userId, int handle);
+	~PS4Gamepad() override;
+
+	// Reads the pad and reports what changed since the last read. False when the pad is gone.
+	bool update();
+
+	const char *get_button_name(u32 code) override;
+	const char *get_axis_name(u32 code) override;
+	std::shared_ptr<InputMapping> getDefaultMapping() override;
+	void resetMappingToDefault(bool arcade, bool gamepad) override;
+
+	void rumble(float power, float inclination, u32 duration_ms) override;
+	void update_rumble() override;
+
+	int userId() const { return user; }
+	u32 buttons() const { return lastButtons; }
+	int axis(u32 a) const { return lastAxes[a]; }
+	int handle() const { return padHandle; }
+
+private:
+	void setVibration(u8 large, u8 small);
+
+	int user;
+	int padHandle;
+	float touchMaxX = 1919.f;
+	u32 lastButtons = 0;
+	int lastAxes[ps4pad::AXIS_COUNT];
+	u64 vibStopTime = 0;
+};
+
+void input_ps4_init();
+void input_ps4_handle();
+void input_ps4_term();
+// The first DualShock 4's handle (the frontend reads it before Flycast starts), or -1.
+int ps4_first_pad_handle();
+// The first pad's latest state for the home screen (shell/ps4/launcher): ScePad button bits and
+// the left stick in -1..1. False when there is no pad.
+bool ps4_pad_state(u32& buttons, float& lx, float& ly);
