+
+namespace ps4fault
+{
+// What a memory fault was (fault_handler) or a page protection change (virtmem::region_*)
+// RttRender: render-to-texture passes started (hw/pvr/Renderer_if.cpp)
+// Shader*: GLSL compiled by glslang / loaded from the SPIR-V disk cache (rend/vulkan/compiler.cpp)
+// Pipeline*: Vulkan pipelines built (rend/vulkan/pipeline.cpp); *Us: microseconds spent
+enum : int { MemWatch, CodePage, Vram, Fpcb, Rewrite, Unhandled, Protect, Unprotect, RttRender,
+	ShaderCompiles, ShaderCompileUs, ShaderCacheHits, Pipelines, PipelineUs, Count };
+}
+extern std::atomic<u64> decast_fault_count[ps4fault::Count];
+
+#include <chrono>
+// Counts one event and the time it took (until the end of the scope).
+struct PS4ScopedTimer
+{
+	int countIndex, usIndex;
+	std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+	PS4ScopedTimer(int countIndex, int usIndex) : countIndex(countIndex), usIndex(usIndex) {}
+	~PS4ScopedTimer() {
+		decast_fault_count[countIndex]++;
+		decast_fault_count[usIndex] += std::chrono::duration_cast<std::chrono::microseconds>(
+				std::chrono::steady_clock::now() - start).count();
+	}
+};
