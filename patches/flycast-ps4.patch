diff --git a/shell/ps4/ps4_vmem.cpp b/shell/ps4/ps4_vmem.cpp
new file mode 100644
index 000000000..53612e149
--- /dev/null
+++ b/shell/ps4/ps4_vmem.cpp
@@ -0,0 +1,333 @@
+/*
+	DeCast-S4: virtual memory (fast memory) on the PS4.
+
+	The PS4 kernel can't reserve hundreds of MiB with mmap(PROT_NONE) and has no anonymous
+	shared memory to map at fixed addresses, so, like DolphinPS4's MemArenaPS4:
+	- the address space is a sceKernelReserveVirtualRange reservation,
+	- the emulated memory is one block of direct (physical) memory, mapped into the reservation
+	  as often as the Dreamcast mirrors it (direct memory aliasing, enabled for the process),
+	- the dynarec's block table (fpcb) is mapped page by page on first access, as on Linux.
+	Everything maps in 16 KiB pages. The JIT code goes into RWX memory near the eboot's code,
+	so generated calls reach it with 32-bit displacements.
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "types.h"
+#include "hw/mem/addrspace.h"
+#include "hw/sh4/sh4_if.h"
+#include "oslib/virtmem.h"
+#include "hw/sh4/dyna/blockmanager.h"
+#include "ps4_stats.h"
+
+#include <sys/mman.h>
+#include <sys/types.h>
+#include <cerrno>
+#include <cstdarg>
+#include <cstdio>
+#include <algorithm>
+#include <vector>
+
+// Declared by hand: several OpenOrbis prototypes are wrong.
+extern "C" {
+size_t sceKernelGetDirectMemorySize();
+int32_t sceKernelAllocateDirectMemory(off_t searchStart, off_t searchEnd, size_t length, size_t alignment,
+		int32_t memoryType, off_t *physicalOut);
+int32_t sceKernelReleaseDirectMemory(off_t start, size_t length);
+int32_t sceKernelMapDirectMemory(void **address, size_t length, int32_t protection, int32_t flags,
+		off_t directMemoryStart, size_t alignment);
+int32_t sceKernelReserveVirtualRange(void **address, size_t length, int32_t flags, size_t alignment);
+int32_t sceKernelMunmap(void *address, size_t length);
+int32_t sceKernelMprotect(const void *address, size_t length, int32_t protection);
+int32_t sceKernelEnableDmemAliasing();
+int32_t sceKernelEnableDmemAliasing2();
+void ps4_boot_trace(const char *line);	// port/ps4_crashlog.cpp
+// the system's mmap (the runtime's --wrap=mmap version moves big mappings far away)
+void *__real_mmap(void *addr, size_t len, int prot, int flags, int fd, off_t offset);
+extern char __text_start[];		// OpenOrbis link.x: start of .text
+}
+
+namespace virtmem
+{
+
+namespace
+{
+constexpr size_t kPage = 0x4000;
+constexpr size_t kReserveAlign = 0x10000;
+constexpr int32_t kWbOnion = 0;			// SCE_KERNEL_WB_ONION
+constexpr int32_t kMapFixed = 0x10;		// SCE_KERNEL_MAP_FIXED
+constexpr int32_t kProtRead = 0x1;		// SCE_KERNEL_PROT_CPU_READ
+constexpr int32_t kProtRW = 0x3;		// SCE_KERNEL_PROT_CPU_RW
+constexpr int32_t kProtRWX = 0x7;
+constexpr size_t kFpcbSize = sizeof(Sh4RCB::fpcb);
+constexpr size_t kLarge = 2_MB;	// large pages: virtual and physical address and size 2 MiB aligned
+
+// The direct memory block (2 MiB aligned): the Sh4RCB (fpcb + SH4 context) at physSh4rcb, the
+// emulated memory right after it. The Sh4RCB's virtual and physical addresses are equal modulo
+// 2 MiB, which puts the emulated memory (sizeof(Sh4RCB) after it) on 2 MiB boundaries in both,
+// and lets the fpcb be mapped in 2 MiB pieces that are aligned in both: the PS4 can then use
+// large pages, and the JIT's block lookups and memory accesses miss the TLB far less.
+off_t dmem = -1;
+size_t dmemSize;
+off_t physSh4rcb;
+u8 *reservedBase;
+size_t reservedSize;
+u8 *sh4rcbBase;		// 64 KiB aligned inside the reservation
+std::vector<bool> fpcbChunkMapped;	// per 2 MiB piece of the fpcb
+
+size_t alignUp(size_t v, size_t a) {
+	return (v + a - 1) & ~(a - 1);
+}
+
+void trace(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+void trace(const char *fmt, ...)
+{
+	char line[256];
+	va_list args;
+	va_start(args, fmt);
+	vsnprintf(line, sizeof(line), fmt, args);
+	va_end(args);
+	ps4_boot_trace(line);
+	NOTICE_LOG(VMEM, "%s", line);
+}
+
+// Maps direct memory [offset, offset + size) at a fixed address inside the reservation.
+bool mapFixed(void *address, size_t size, off_t offset, bool writable)
+{
+	void *addr = address;
+	const bool large = (((uintptr_t)address | (uintptr_t)(dmem + offset) | size) & (kLarge - 1)) == 0;
+	const int32_t r = sceKernelMapDirectMemory(&addr, alignUp(size, kPage), writable ? kProtRW : kProtRead,
+			kMapFixed, dmem + offset, large ? kLarge : kPage);
+	if (r != 0 || addr != address)
+	{
+		ERROR_LOG(VMEM, "PS4: mapping %zx bytes of direct memory +%llx at %p failed: %x",
+				size, (unsigned long long)offset, address, r);
+		return false;
+	}
+	return true;
+}
+
+// Unmaps a range of the reservation and reserves it again, so nothing else lands there.
+void unmapToReserved(void *address, size_t size)
+{
+	size = alignUp(size, kPage);
+	sceKernelMunmap(address, size);
+	void *addr = address;
+	const int32_t r = sceKernelReserveVirtualRange(&addr, size, kMapFixed, kPage);
+	if (r != 0 || addr != address)
+		ERROR_LOG(VMEM, "PS4: re-reserving %p failed: %x", address, r);
+}
+} // namespace
+
+bool region_lock(void *start, size_t len)
+{
+	decast_fault_count[ps4fault::Protect]++;
+	const size_t inpage = (uintptr_t)start & PAGE_MASK;
+	const int32_t r = sceKernelMprotect((u8 *)start - inpage, alignUp(len + inpage, kPage), kProtRead);
+	if (r != 0)
+		die("sceKernelMprotect (lock) failed");
+	return true;
+}
+
+bool region_unlock(void *start, size_t len)
+{
+	decast_fault_count[ps4fault::Unprotect]++;
+	const size_t inpage = (uintptr_t)start & PAGE_MASK;
+	const int32_t r = sceKernelMprotect((u8 *)start - inpage, alignUp(len + inpage, kPage), kProtRW);
+	if (r != 0)
+		die("sceKernelMprotect (unlock) failed");
+	return true;
+}
+
+bool region_set_exec(void *start, size_t len)
+{
+	const size_t inpage = (uintptr_t)start & PAGE_MASK;
+	return sceKernelMprotect((u8 *)start - inpage, alignUp(len + inpage, kPage), kProtRWX) == 0;
+}
+
+bool init(void **vmem_base_addr, void **sh4rcb_addr, size_t ramSize)
+{
+	static bool aliasingTried;
+	if (!aliasingTried)
+	{
+		// mapping the same direct memory twice (the Dreamcast's mirrors) fails with EBUSY until
+		// aliasing is enabled for the process
+		aliasingTried = true;
+		const int32_t r1 = sceKernelEnableDmemAliasing();
+		const int32_t r2 = r1 == 0 ? 0 : sceKernelEnableDmemAliasing2();
+		trace("vmem: direct memory aliasing %x, aliasing2 %x", r1, r2);
+	}
+
+	// the Sh4RCB starts this far below a 2 MiB boundary, in both address spaces
+	const size_t lead = (kLarge - sizeof(Sh4RCB) % kLarge) % kLarge;
+	physSh4rcb = lead;
+	dmemSize = alignUp(lead + sizeof(Sh4RCB) + ramSize, kLarge);
+	off_t physical = 0;
+	int32_t r = sceKernelAllocateDirectMemory(0, (off_t)sceKernelGetDirectMemorySize(), dmemSize, kLarge,
+			kWbOnion, &physical);
+	if (r != 0)
+	{
+		trace("vmem: allocating %zu MiB of direct memory failed: %x", dmemSize >> 20, r);
+		return false;
+	}
+	dmem = physical;
+
+	reservedSize = 512_MB + sizeof(Sh4RCB) + ARAM_SIZE_MAX + 2 * kLarge;
+	// above the kernel's own allocations at 0x200000000 (DolphinPS4: they wrecked a heap there).
+	// A hint whose range isn't free fails (ENOMEM) instead of searching on: try a few.
+	void *base = nullptr;
+	for (uintptr_t hint : { 0x2000000000ull, 0x1800000000ull, 0x3000000000ull, 0x900000000ull, 0x0ull })
+	{
+		base = (void *)hint;
+		r = sceKernelReserveVirtualRange(&base, reservedSize, 0, kLarge);
+		if (r == 0)
+			break;
+		trace("vmem: reserving %zu MiB at %p failed: %x", reservedSize >> 20, (void *)hint, r);
+	}
+	if (r != 0)
+	{
+		trace("vmem: reserving %zu MiB of address space failed: %x", reservedSize >> 20, r);
+		sceKernelReleaseDirectMemory(dmem, dmemSize);
+		dmem = -1;
+		return false;
+	}
+	reservedBase = (u8 *)base;
+	// same offset from a 2 MiB boundary as physSh4rcb: the emulated memory after it is aligned
+	sh4rcbBase = (u8 *)alignUp((uintptr_t)reservedBase, kLarge) + lead;
+	verify(((uintptr_t)(sh4rcbBase + sizeof(Sh4RCB)) & (kLarge - 1)) == 0
+			&& ((physSh4rcb + sizeof(Sh4RCB)) & (kLarge - 1)) == 0);
+	fpcbChunkMapped.assign(kFpcbSize / kLarge + 2, false);
+
+	// the SH4 context after the fpcb; the fpcb itself is mapped on demand (ondemand_page)
+	if (!mapFixed(sh4rcbBase + kFpcbSize, sizeof(Sh4RCB) - kFpcbSize, physSh4rcb + kFpcbSize, true))
+	{
+		destroy();
+		return false;
+	}
+	*sh4rcb_addr = sh4rcbBase;
+	*vmem_base_addr = sh4rcbBase + sizeof(Sh4RCB);
+	trace("vmem: %zu MiB of direct memory at %llx, address space at %p, sh4rcb %p, ram base %p (2 MiB aligned)",
+			dmemSize >> 20, (unsigned long long)dmem, reservedBase, sh4rcbBase, *vmem_base_addr);
+	return true;
+}
+
+void destroy()
+{
+	if (reservedBase != nullptr)
+	{
+		sceKernelMunmap(reservedBase, reservedSize);
+		reservedBase = nullptr;
+		sh4rcbBase = nullptr;
+	}
+	if (dmem >= 0)
+	{
+		sceKernelReleaseDirectMemory(dmem, dmemSize);
+		dmem = -1;
+	}
+}
+
+// The fpcb goes back to faulting on first access.
+void reset_mem(void *ptr, unsigned size_bytes)
+{
+	unmapToReserved(ptr, size_bytes);
+	std::fill(fpcbChunkMapped.begin(), fpcbChunkMapped.end(), false);
+}
+
+// The fpcb page holding `address`: maps the whole 2 MiB piece around it (clipped to the fpcb)
+// and fills it with "no block yet" (the caller, bm_lockedWrite, fills its own page again).
+void ondemand_page(void *address, unsigned size_bytes)
+{
+	u8 *fpcbStart = sh4rcbBase;
+	u8 *fpcbEnd = sh4rcbBase + kFpcbSize;
+	u8 *start = std::max(fpcbStart, (u8 *)((uintptr_t)address & ~(uintptr_t)(kLarge - 1)));
+	u8 *end = std::min(fpcbEnd, (u8 *)(((uintptr_t)address & ~(uintptr_t)(kLarge - 1)) + kLarge));
+	// pieces numbered from the 2 MiB boundary at or below the fpcb's start
+	const size_t chunk = (((uintptr_t)address & ~(uintptr_t)(kLarge - 1)) - ((uintptr_t)fpcbStart & ~(uintptr_t)(kLarge - 1))) / kLarge;
+	if (chunk < fpcbChunkMapped.size() && fpcbChunkMapped[chunk])
+	{
+		// already mapped (a fault on a page mapped meanwhile by another thread): nothing to do
+		return;
+	}
+	const bool ok = mapFixed(start, end - start, physSh4rcb + (start - sh4rcbBase), true);
+	verify(ok);
+	bm_vmem_pagefill((void **)start, (u32)(end - start));
+	if (chunk < fpcbChunkMapped.size())
+		fpcbChunkMapped[chunk] = true;
+}
+
+void create_mappings(const Mapping *vmem_maps, unsigned nummaps)
+{
+	for (unsigned i = 0; i < nummaps; i++)
+	{
+		// unmapped areas stay reserved (they fault)
+		if (vmem_maps[i].memsize == 0)
+			continue;
+		const u64 rangeSize = vmem_maps[i].end_address - vmem_maps[i].start_address;
+		const unsigned mirrors = rangeSize / vmem_maps[i].memsize;
+		verify((rangeSize % vmem_maps[i].memsize) == 0 && mirrors >= 1);
+		for (unsigned j = 0; j < mirrors; j++)
+		{
+			const u64 offset = vmem_maps[i].start_address + j * vmem_maps[i].memsize;
+			u8 *address = &addrspace::ram_base[offset];
+			// a mapping from an earlier game (another memory size) may be in the way
+			unmapToReserved(address, vmem_maps[i].memsize);
+			const bool ok = mapFixed(address, vmem_maps[i].memsize, physSh4rcb + sizeof(Sh4RCB) + vmem_maps[i].memoffset,
+					vmem_maps[i].allow_writes);
+			verify(ok);
+		}
+	}
+}
+
+// RWX memory close to the eboot's code: the x64 dynarecs call into it, and it calls back, with
+// 32-bit displacements.
+bool prepare_jit_block(void *code_area, size_t size, void **code_area_rwx)
+{
+	const uintptr_t text = (uintptr_t)__text_start;
+	size = alignUp(size, kPage);
+	// FreeBSD looks for free space from the hint upwards
+	for (uintptr_t hint = alignUp(text + 64_MB, kReserveAlign); hint < text + 1536_MB; hint += 64_MB)
+	{
+		void *p = __real_mmap((void *)hint, size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANON, -1, 0);
+		if (p == MAP_FAILED)
+			continue;
+		const intptr_t distance = (intptr_t)p - (intptr_t)text;
+		if (distance > -(intptr_t)1800_MB && distance < (intptr_t)1800_MB)
+		{
+			trace("vmem: %zu KiB of JIT code at %p (text at %p)", size >> 10, p, __text_start);
+			*code_area_rwx = p;
+			return true;
+		}
+		munmap(p, size);
+	}
+	trace("vmem: no RWX memory near the code for %zu KiB of JIT code (errno %d)", size >> 10, errno);
+	return false;
+}
+
+void release_jit_block(void *code_area, size_t size)
+{
+	munmap(code_area, alignUp(size, kPage));
+}
+
+// Separate RW and RX views: not needed, the PS4 allows RWX.
+bool prepare_jit_block(void *code_area, size_t size, void **code_area_rw, ptrdiff_t *rx_offset)
+{
+	return false;
+}
