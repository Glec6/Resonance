+
+extern "C" void ps4_boot_trace(const char *line);	// port/ps4_crashlog.cpp
+extern "C" void ps4_watch_thread(const char *name);	// port/ps4_sampler.cpp
+extern "C" void ps4_sampler_register_thread(const char *name);
+extern "C" void ps4_sampler_start();
+extern "C" void ps4_thread_busy_report(char *out, size_t size, int min_percent);
+extern "C" void ac_ps4_get_gpu_busy(uint64_t *busy_ticks, uint64_t *span_ticks);	// port/mesa/ac_ps4_drm.c
+void common_linux_setup();	// core/linux/common.cpp
+extern u32 MainFrameCount;	// ui/mainui.cpp: frames shown
+extern std::atomic<u64> ps4_vblank_count;	// hw/pvr/spg.cpp: emulated vblanks
+float ps4_vblank_rate();
+void gui_saveFrameQuiet(const std::string& name);	// ui/gui.cpp
+void gui_runOnUiThread(std::function<void()> function);
+void vulkan_save_pipeline_cache();	// rend/vulkan/vulkan_context.cpp
+
+namespace
+{
+const std::string kDataRoot = "/data/DeCast-S4";
+
+void trace(const std::string& line) {
+	ps4_boot_trace(line.c_str());
+}
+
+void loadSystemModules()
+{
+	// calling into a system library whose module isn't loaded kills the app silently
+	const std::pair<const char *, u32> modules[] = {
+		{ "SystemService", 0x80000010 }, { "UserService", 0x80000011 }, { "VideoOut", 0x80000022 },
+		{ "AudioOut", 0x80000001 }, { "Pad", 0x80000024 }, { "Net", 0x8000001C },
+	};
+	for (const auto& [name, id] : modules)
+	{
+		const int result = (int)sceSysmoduleLoadModuleInternal((OrbisSysModuleInternal)id);
+		if (result != 0)
+		{
+			char line[96];
+			snprintf(line, sizeof(line), "loading system module %s failed (%x)", name, (u32)result);
+			trace(line);
+		}
+	}
+}
+
+std::string appVersion()
+{
+	FILE *f = fopen("/app0/version.txt", "r");
+	if (f == nullptr)
+		return "?";
+	char buf[32] {};
+	if (fgets(buf, sizeof(buf), f) == nullptr)
+		buf[0] = '\0';
+	fclose(f);
+	std::string v(buf);
+	while (!v.empty() && (v.back() == '\n' || v.back() == '\r' || v.back() == ' '))
+		v.pop_back();
+	return v;
+}
+
+bool profiling;		// /data/DeCast-S4/profile.txt exists: the sampling profiler runs
+
+// Performance monitor: every 5 s a line in boot-trace.log with the frame rate, the emulation speed
+// (emulated vblanks against the console's rate), how busy the GPU was (GPU timestamps around each
+// submission) and each named thread at 10% or more (a thread near 100% limits the speed).
+void startPerfMonitor()
+{
+	std::thread([] {
+		ps4_watch_thread("PerfMonitor");
+		u32 lastFrames = MainFrameCount;
+		u64 lastVblanks = ps4_vblank_count;
+		u64 lastBusy = 0, lastSpan = 0;
+		u64 lastFaults[ps4fault::Count] {};
+		u64 pipelinesSinceSave = 0;
+		ac_ps4_get_gpu_busy(&lastBusy, &lastSpan);
+		auto last = std::chrono::steady_clock::now();
+		for (;;)
+		{
+			std::this_thread::sleep_for(std::chrono::seconds(5));
+			const auto now = std::chrono::steady_clock::now();
+			const double secs = std::chrono::duration<double>(now - last).count();
+			last = now;
+			const u32 frames = MainFrameCount;
+			const u64 vblanks = ps4_vblank_count;
+			u64 busy, span;
+			ac_ps4_get_gpu_busy(&busy, &span);
+			char threads[640];
+			ps4_thread_busy_report(threads, sizeof(threads), 10);
+			// faults per second by kind (core/linux/common.cpp) and page (un)protections (ps4_vmem.cpp)
+			u64 faults[ps4fault::Count];
+			for (int i = 0; i < ps4fault::Count; i++)
+			{
+				const u64 v = decast_fault_count[i];
+				faults[i] = v - lastFaults[i];
+				lastFaults[i] = v;
+			}
+			// shaders and pipelines built in this window (the stutter when a scene needs new ones)
+			char compiles[160] = "";
+			if (faults[ps4fault::ShaderCompiles] || faults[ps4fault::ShaderCacheHits] || faults[ps4fault::Pipelines])
+				snprintf(compiles, sizeof(compiles), " | shaders: %llu compiled (%llu ms), %llu from cache; pipelines: %llu (%llu ms)",
+						(unsigned long long)faults[ps4fault::ShaderCompiles], (unsigned long long)faults[ps4fault::ShaderCompileUs] / 1000,
+						(unsigned long long)faults[ps4fault::ShaderCacheHits],
+						(unsigned long long)faults[ps4fault::Pipelines], (unsigned long long)faults[ps4fault::PipelineUs] / 1000);
+			// the Vulkan pipeline cache, once a burst of new pipelines is over (the PS4 never calls
+			// term(), which used to be the only place it was saved)
+			pipelinesSinceSave += faults[ps4fault::Pipelines];
+			if (pipelinesSinceSave > 0 && faults[ps4fault::Pipelines] == 0)
+			{
+				gui_runOnUiThread([] { vulkan_save_pipeline_cache(); });
+				pipelinesSinceSave = 0;
+			}
+			char line[1100];
+			snprintf(line, sizeof(line), "perf: fps %.1f, speed %.0f%%, gpu %llu%% | faults/s: memwatch %.0f code %.0f vram %.0f fpcb %.0f rewrite %.0f other %.0f, protect %.0f unprotect %.0f, rtt %.0f/s%s | %s",
+					(frames - lastFrames) / secs, (vblanks - lastVblanks) / secs / ps4_vblank_rate() * 100.0,
+					span > lastSpan ? (unsigned long long)((busy - lastBusy) * 100 / (span - lastSpan)) : 0ull,
+					faults[ps4fault::MemWatch] / secs, faults[ps4fault::CodePage] / secs, faults[ps4fault::Vram] / secs,
+					faults[ps4fault::Fpcb] / secs, faults[ps4fault::Rewrite] / secs, faults[ps4fault::Unhandled] / secs,
+					faults[ps4fault::Protect] / secs, faults[ps4fault::Unprotect] / secs, faults[ps4fault::RttRender] / secs, compiles, threads);
+			ps4_boot_trace(line);
+			// screens.txt: the emulated picture every 5 s (screenshots/frame-<seconds>.png)
+			if (access((kDataRoot + "/screens.txt").c_str(), F_OK) == 0)
+			{
+				static int shot;
+				char name[48];
+				snprintf(name, sizeof(name), "frame-%04d.png", ++shot * 5);
+				gui_saveFrameQuiet(name);
+			}
+			lastFrames = frames;
+			lastVblanks = vblanks;
+			lastBusy = busy;
+			lastSpan = span;
+		}
+	}).detach();
+}
+
+// Exceptions thrown for the first time take a slow path (unwinder setup); do it before the JIT.
+void warmUpExceptions()
+{
+	try {
+		throw 1;
+	} catch (...) {
+	}
+}
+} // namespace
+
+int main(int argc, char *argv[])
+{
+	loadSystemModules();
+	trace("DeCast-S4 " + appVersion() + " starting");
+
+	flycast::mkdir(kDataRoot.c_str(), 0777);
+	flycast::mkdir((kDataRoot + "/data").c_str(), 0777);
+	flycast::mkdir((kDataRoot + "/games").c_str(), 0777);
+	set_user_config_dir(kDataRoot + "/");
+	set_user_data_dir(kDataRoot + "/data/");
+	add_system_config_dir(kDataRoot + "/");
+	add_system_config_dir("/app0/");
+	add_system_data_dir(kDataRoot + "/data/");
+	add_system_data_dir("/app0/data/");
+
+	// full HD through VideoOut; the menus are sized for a TV across the room
+	settings.display.width = ps4wsi::kWidth;
+	settings.display.height = ps4wsi::kHeight;
+	settings.display.dpi = 200.f;
+
+	profiling = access((kDataRoot + "/profile.txt").c_str(), F_OK) == 0;
+	if (profiling)
+		ps4_sampler_start();
+	LogManager::Init();
+	i18n::init();
+	warmUpExceptions();
+	// the fault handler (fast memory, the dynarec's block table, VRAM write tracking), as Linux's main()
+	common_linux_setup();
+
+	trace("flycast_init");
+	if (flycast_init(argc, argv) != 0)
+	{
+		trace("flycast_init failed");
+		return 1;
+	}
+	// the frame rate and speed on screen, once (the user can turn it off in Video settings)
+	if (!config::loadBool("decast", "ShowFPSDefault", false))
+	{
+		config::ShowFPS.set(true);
+		config::saveBool("decast", "ShowFPSDefault", true);
+		SaveSettings();
+	}
+	startPerfMonitor();
+	// first start: the games folder is the content folder
+	if (config::ContentPath.get().empty())
+	{
+		config::ContentPath.get().push_back(kDataRoot + "/games");
+		SaveSettings();
+		trace("content folder set to " + kDataRoot + "/games");
+	}
+
+	trace("main loop");
+	try {
+		mainui_loop();
+	} catch (const std::exception& e) {
+		ERROR_LOG(BOOT, "mainui_loop error: %s", e.what());
+		trace(std::string("main loop error: ") + e.what());
+	} catch (...) {
+		ERROR_LOG(BOOT, "mainui_loop unknown exception");
+		trace("main loop: unknown exception");
+	}
+
+	trace("exiting");
+	flycast_term();
+	return 0;
+}
+
+// os_SetThreadName (core/linux/common.cpp): named threads appear in the crash and hang reports, and
+// in the profiler's samples when it runs
+void ps4_name_thread(const char *name)
+{
+	// the sampler has a few slots: the threads that do the emulation's work
+	static const char *const profiled[] = { "Flycast-emu", "Flycast-rend", "PS4AudioOut" };
+	bool sample = false;
+	for (const char *p : profiled)
+		sample |= profiling && strcmp(name, p) == 0;
+	if (sample)
+		ps4_sampler_register_thread(name);
+	else
+		ps4_watch_thread(name);
+}
+
+void os_DoEvents()
+{
+}
+
+void os_RunInstance(int argc, const char *argv[])
+{
+	// Naomi multiboard needs a second emulator process: not on the PS4
+	WARN_LOG(BOOT, "os_RunInstance: not supported on PS4");
+}
+
+[[noreturn]] void os_DebugBreak()
+{
+	// the crash handler (port/ps4_crashlog.cpp) records where
+	__builtin_trap();
+}
+
+// The emulator's view of a crash (port/ps4_crashlog.cpp calls it after the host stacks): the
+// SH4's registers, appended to crash.log. No allocation, no locks.
+extern "C" void ps4_crash_guest_info()
+{
+	if (p_sh4rcb == nullptr)
+		return;
+	const int fd = open((kDataRoot + "/crash.log").c_str(), O_WRONLY | O_CREAT | O_APPEND, 0666);
+	if (fd < 0)
+		return;
+	const Sh4Context& ctx = p_sh4rcb->cntx;
+	char line[256];
+	int n = snprintf(line, sizeof(line), "\n== SH4 at the crash: pc %08x pr %08x sr %08x fpscr %08x game %s\n",
+			ctx.pc, ctx.pr, ctx.sr.getFull(), ctx.fpscr.full, settings.content.gameId.c_str());
+	write(fd, line, n);
+	for (int i = 0; i < 16; i += 4)
+	{
+		n = snprintf(line, sizeof(line), "r%-2d %08x  r%-2d %08x  r%-2d %08x  r%-2d %08x\n",
+				i, ctx.r[i], i + 1, ctx.r[i + 1], i + 2, ctx.r[i + 2], i + 3, ctx.r[i + 3]);
+		write(fd, line, n);
+	}
+	close(fd);
+}
+
+namespace hostfs
+{
+
+std::string getScreenshotsPath()
+{
+	const std::string path = kDataRoot + "/screenshots";
+	flycast::mkdir(path.c_str(), 0777);
+	return path;
+}
+
+}
