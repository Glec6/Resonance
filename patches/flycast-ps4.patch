+#ifdef __ORBIS__
+// DeCast-S4: glslang is slow on the PS4's Jaguar cores (tens of ms per shader), and every new
+// scene needs new shader variants, so the SPIR-V is kept on disk (data/shadercache/<hash>.spv,
+// keyed by the GLSL source and stage): each variant is compiled once, not once per session.
+namespace
+{
+constexpr u32 kSpvCacheMagic = 0x31565053;	// "SPV1"
+
+std::string spvCachePath(vk::ShaderStageFlagBits stage, const std::string& text)
+{
+	static bool dirMade;
+	if (!dirMade) {
+		flycast::mkdir(hostfs::getShaderCachePath("shadercache").c_str(), 0777);
+		dirMade = true;
+	}
+	const u64 h = XXH64(text.data(), text.size(), (u64)stage);
+	char name[64];
+	snprintf(name, sizeof(name), "shadercache/%016llx.spv", (unsigned long long)h);
+	return hostfs::getShaderCachePath(name);
+}
+
+bool loadSpv(const std::string& path, size_t textSize, std::vector<unsigned int>& spv)
+{
+	FILE *f = nowide::fopen(path.c_str(), "rb");
+	if (f == nullptr)
+		return false;
+	u32 header[3];
+	bool ok = std::fread(header, sizeof(header), 1, f) == 1 && header[0] == kSpvCacheMagic
+			&& header[1] == (u32)textSize && header[2] > 0 && header[2] < 4 * 1024 * 1024;
+	if (ok) {
+		spv.resize(header[2]);
+		ok = std::fread(spv.data(), sizeof(unsigned int), spv.size(), f) == spv.size();
+	}
+	std::fclose(f);
+	return ok;
+}
+
+void saveSpv(const std::string& path, size_t textSize, const std::vector<unsigned int>& spv)
+{
+	// written aside and renamed: a power cut never leaves a truncated entry
+	const std::string tmp = path + ".tmp";
+	FILE *f = nowide::fopen(tmp.c_str(), "wb");
+	if (f == nullptr)
+		return;
+	const u32 header[3] { kSpvCacheMagic, (u32)textSize, (u32)spv.size() };
+	bool ok = std::fwrite(header, sizeof(header), 1, f) == 1
+			&& std::fwrite(spv.data(), sizeof(unsigned int), spv.size(), f) == spv.size();
+	std::fclose(f);
+	if (ok)
+		ok = std::rename(tmp.c_str(), path.c_str()) == 0;
+	if (!ok)
+		std::remove(tmp.c_str());
+}
+}
+#endif
+
 vk::UniqueShaderModule ShaderCompiler::Compile(vk::ShaderStageFlagBits shaderStage, std::string const& shaderText)
 {
 	std::vector<unsigned int> shaderSPV;
+#ifdef __ORBIS__
