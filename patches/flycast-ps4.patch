+// A ring of the disc (fractions f0..f1 of the radius) as one triangle strip; uv and colour per vertex.
+// sy squashes (or, negative, mirrors) the disc vertically.
+template<typename UV, typename COL>
+void annulus(ImDrawList *dl, ImTextureID tex, ImVec2 c, float r, float sy, float f0, float f1, int segments,
+		UV uv, COL col)
+{
+	const bool textured = tex != ImTextureID();
+	if (textured)
+		dl->PushTexture(tex);
+	const ImVec2 white = whiteUV(dl);
+	dl->PrimReserve(segments * 6, (segments + 1) * 2);
+	const u32 base = dl->_VtxCurrentIdx;
+	for (int i = 0; i <= segments; i++)
+	{
+		const float a = 2 * PI * i / segments, ca = std::cos(a), sa = std::sin(a);
+		for (int j = 0; j < 2; j++)
+		{
+			const float fr = j == 0 ? f0 : f1;
+			const ImVec2 p(c.x + ca * fr * r, c.y + sa * fr * r * sy);
+			dl->PrimWriteVtx(p, textured ? uv(a, fr) : white, col(a, fr, p));
+		}
+	}
+	for (int i = 0; i < segments; i++)
+	{
+		const ImDrawIdx v = (ImDrawIdx)(base + i * 2);
+		dl->PrimWriteIdx(v); dl->PrimWriteIdx(v + 1); dl->PrimWriteIdx(v + 3);
+		dl->PrimWriteIdx(v); dl->PrimWriteIdx(v + 3); dl->PrimWriteIdx(v + 2);
+	}
+	if (textured)
+		dl->PopTexture();
+}
+
+class Orbit : public Theme
+{
+public:
+	const char *name() const override { return "Orbit"; }
+	float launchSeconds() const override { return 1.5f; }
+
+	void draw(Frame& f) override
+	{
+		std::vector<Game>& games = *f.games;
+		const int n = (int)games.size();
+		if (!started)
+		{
+			started = true;
+			pos = (float)f.goal;
+			if (n > 0)
+			{
+				bg1 = games[f.sel].c1;
+				bg2 = games[f.sel].c2;
+			}
+		}
+		spring(pos, vel, (float)f.goal, 90.f, 19.f, f.dt);
+		const float launch = f.launchAt >= 0 ? clamp01((f.t - f.launchAt) / launchSeconds()) : 0.f;
+		spin += f.dt * (.35f + 14.f * launch * launch);
+		if (n > 0)
+		{
+			approach(bg1, games[f.sel].c1, 3.f, f.dt);
+			approach(bg2, games[f.sel].c2, 3.f, f.dt);
+		}
+		drawRoom(f);
+		if (n == 0)
+		{
+			drawEmptyLibrary(f);
+			drawHints(f);
+			return;
+		}
+
+		// the ring: an ellipse seen from above, the selected disc in front
+		const float cx = f.w * .5f, cy = f.h * .43f;
+		const float rx = f.w * .40f * (1 + launch * launch * 1.2f), ry = f.h * .13f;
+		f.dl->AddEllipse(ImVec2(cx, cy - ry), ImVec2(rx, ry), bg1.u32(.16f * (1 - launch)), 0, 96, 1.5f);
+
+		struct Slot { int game; float k, z; ImVec2 c; float r, alpha; };
+		std::vector<Slot> slots;
+		const float half = std::min(4.f, (n - 1) * .5f);
+		for (int i = (int)std::floor(pos) - 5; i <= (int)std::ceil(pos) + 5; i++)
+		{
+			const float k = i - pos;
+			const float alpha = clamp01(half + 1.f - std::fabs(k));
+			if (alpha <= 0.f)
+				continue;
+			const float th = k * .42f;
+			Slot s;
+			s.game = ((i % n) + n) % n;
+			s.k = k;
+			s.z = std::cos(th);
+			s.c = ImVec2(cx + std::sin(th) * rx, cy - (1 - s.z) * ry);
+			const float depth = .45f + .55f * (s.z + 1) * .5f;
+			const float near = clamp01(1 - std::fabs(k));
+			s.r = f.h * .2f * depth * (.66f + .34f * near);
+			s.alpha = alpha * (std::fabs(k) < .5f ? 1.f : 1.f - launch);
+			if (std::fabs(k) < .5f)
+				s.r *= 1 + .35f * easeOut(launch);
+			slots.push_back(s);
+		}
+		std::sort(slots.begin(), slots.end(), [](const Slot& a, const Slot& b) { return a.z < b.z; });
+
+		// reflections first (the floor), then the discs
+		for (const Slot& s : slots)
+		{
+			const float floorY = s.c.y + s.r * 1.04f;
+			drawDisc(f, games[s.game], ImVec2(s.c.x, floorY + s.r * .55f), s.r, -.55f, spin + s.game * 1.7f,
+					s.alpha * .22f, floorY, s.r * 1.1f);
+		}
+		for (const Slot& s : slots)
+		{
+			// a soft coloured light under each disc
+			drawBlob(f.dl, s.c, s.r * 1.9f, games[s.game].c1.u32(.20f * s.alpha));
+			drawDisc(f, games[s.game], s.c, s.r, 1.f, spin * (std::fabs(s.k) < .5f ? 1.6f : 1.f) + s.game * 1.7f,
+					s.alpha, 0, 0);
+		}
+
+		// launch: a shock ring from the disc, then a flash and black
+		if (launch > 0)
+		{
+			const ImVec2 c(cx, cy);
+			for (int i = 0; i < 2; i++)
+			{
+				const float p = clamp01(launch * 1.6f - i * .25f);
+				if (p > 0 && p < 1)
+					f.dl->AddCircle(c, f.h * .2f + p * f.w * .55f, bg1.u32((1 - p) * .7f), 128, 3.f + 8.f * (1 - p));
+			}
+			const float flash = clamp01((launch - .62f) / .12f) * clamp01((1.f - launch) / .2f + .3f);
+			f.dl->AddRectFilled(ImVec2(0, 0), ImVec2(f.w, f.h), IM_COL32(255, 255, 255, (int)(140 * flash)));
+		}
+
+		drawInfo(f, games[f.sel], 1.f - launch);
+		drawHints(f, 1.f - launch);
+		if (launch > .75f)
+			f.dl->AddRectFilled(ImVec2(0, 0), ImVec2(f.w, f.h), IM_COL32(0, 0, 0, (int)(255 * clamp01((launch - .75f) / .25f))));
+	}
+
+private:
+	void drawRoom(Frame& f)
+	{
+		ImDrawList *dl = f.dl;
+		const Color top = mix(bg2, { 0, 0, 0 }, .35f), bottom = { .01f, .01f, .02f };
+		dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(f.w, f.h), top.u32(), top.u32(), bottom.u32(), bottom.u32());
+		// slow coloured light drifting behind the ring
+		for (int i = 0; i < 3; i++)
+		{
+			const float a = f.t * (.05f + .02f * i) + i * 2.1f;
+			const ImVec2 c(f.w * (.5f + .32f * std::cos(a)), f.h * (.38f + .2f * std::sin(a * 1.3f)));
+			drawBlob(dl, c, f.h * (.75f + .15f * i), mix(bg1, bg2, .3f * i).u32(.10f));
+		}
+		// stars that drift with the ring
+		u32 x = 2463534242u;
+		for (int i = 0; i < 140; i++)
+		{
+			x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+			const float sx = (x & 0xffff) / 65535.f, sy = (x >> 16) / 65535.f;
+			const float depth = .3f + .7f * ((i * 37) % 100) / 100.f;
+			float px = std::fmod(sx * f.w - pos * 14.f * depth, f.w);
+			if (px < 0)
+				px += f.w;
+			const float tw = .5f + .5f * std::sin(f.t * (1.f + depth * 2) + i);
+			dl->AddCircleFilled(ImVec2(px, sy * f.h * .8f), 1.f + depth * 1.4f, IM_COL32(220, 230, 255, (int)(40 + 110 * tw * depth)), 6);
+		}
+		// floor: a dark glossy plane
+		const float floorY = f.h * .62f;
+		dl->AddRectFilledMultiColor(ImVec2(0, floorY), ImVec2(f.w, f.h), IM_COL32(0, 0, 0, 0), IM_COL32(0, 0, 0, 0),
+				IM_COL32(0, 0, 0, 200), IM_COL32(0, 0, 0, 200));
+		dl->AddLine(ImVec2(0, floorY), ImVec2(f.w, floorY), bg1.u32(.08f), 1.f);
+	}
+
+	// One disc. fadeTop/fadeLen > 0: a reflection, fading out below fadeTop.
+	void drawDisc(Frame& f, const Game& g, ImVec2 c, float r, float sy, float rot, float alpha, float fadeTop, float fadeLen)
+	{
+		if (alpha <= .003f)
+			return;
+		ImDrawList *dl = f.dl;
+		const float light = -2.3f;		// the light is up and to the left
+		auto fade = [&](const ImVec2& p) {
+			return fadeLen > 0 ? alpha * clamp01(1 - (p.y - fadeTop) / fadeLen) : alpha;
+		};
+		const ImTextureID cover = coverTexture(g);
+		const float labelR = .74f, hubR = .3f;
+		// silver rim: bands of light fixed to the room while the pressing spins under them
+		annulus(dl, discTexture(), c, r, sy, labelR, 1.f, 72,
+			[&](float a, float fr) { return ImVec2(.5f + .5f * fr * std::cos(a), .5f + .5f * fr * std::sin(a)); },
+			[&](float a, float fr, const ImVec2& p) {
+				const float glint = std::pow(std::fmax(0.f, std::cos(a - light)), 6.f) + .6f * std::pow(std::fmax(0.f, std::cos(a - light - PI)), 10.f);
+				const float v = .78f + .5f * glint;
+				return Color { v, v, v * 1.02f }.u32(fade(p));
+			});
+		// the label: the cover, printed on the disc and turning with it
+		if (cover != ImTextureID())
+			annulus(dl, cover, c, r, sy, hubR, labelR, 72,
+				[&](float a, float fr) {
+					const float u = fr / labelR * .5f;
+					return ImVec2(.5f + u * std::cos(a - rot), .5f + u * std::sin(a - rot));
+				},
+				[&](float a, float fr, const ImVec2& p) {
+					const float sheen = .9f + .18f * std::pow(std::fmax(0.f, std::cos(a - light)), 4.f);
+					return Color { sheen, sheen, sheen }.u32(fade(p));
+				});
+		else
+			// no cover: the game's colours in turning stripes
+			annulus(dl, ImTextureID(), c, r, sy, hubR, labelR, 72,
+				[](float, float) { return ImVec2(); },
+				[&](float a, float fr, const ImVec2& p) {
+					const float stripe = .5f + .5f * std::sin((a - rot) * 3 + fr * 9);
+					return mix(g.c2, g.c1, .35f + .55f * stripe * fr).u32(fade(p));
+				});
+		// clear hub and the hole
+		annulus(dl, ImTextureID(), c, r, sy, .12f, hubR, 48, [](float, float) { return ImVec2(); },
+			[&](float a, float fr, const ImVec2& p) {
+				return Color { .75f, .8f, .88f }.u32(fade(p) * (.28f + .25f * (fr - .12f) / (hubR - .12f)));
+			});
+		annulus(dl, ImTextureID(), c, r, sy, labelR - .012f, labelR + .006f, 72, [](float, float) { return ImVec2(); },
+			[&](float, float, const ImVec2& p) { return IM_COL32(20, 22, 28, (int)(120 * fade(p))); });
+		// edge highlight
+		annulus(dl, ImTextureID(), c, r, sy, .985f, 1.f, 72, [](float, float) { return ImVec2(); },
+			[&](float a, float, const ImVec2& p) {
+				return IM_COL32(255, 255, 255, (int)(255 * fade(p) * (.25f + .6f * std::fmax(0.f, std::cos(a - light)))));
+			});
+	}
+
+	void drawInfo(Frame& f, const Game& g, float alpha)
+	{
+		if (alpha <= 0)
+			return;
+		ImDrawList *dl = f.dl;
+		ImFont *display = displayFont();
+		// brand and clock
+		drawText(dl, display, f.h * .022f, ImVec2(f.w * .05f, f.h * .055f), IM_COL32(255, 255, 255, (int)(200 * alpha)), "DECAST-S4");
+		char clock[16];
+		const time_t now = time(nullptr);
+		strftime(clock, sizeof(clock), "%H:%M", localtime(&now));
+		drawText(dl, display, f.h * .026f, ImVec2(f.w * .95f, f.h * .05f), IM_COL32(255, 255, 255, (int)(220 * alpha)), clock, 1.f);
+
+		// the title, letter by letter after each move
+		const float size = f.h * .058f;
+		const float x0 = f.w * .5f, y0 = f.h * .73f;
+		const float age = f.t - f.selectedAt;
+		const std::string& title = g.e.title;
+		const float total = textWidth(display, size, title);
+		const float scale = total > f.w * .86f ? f.w * .86f / total : 1.f;
+		const float fs = size * scale;
+		float x = x0 - total * scale * .5f;
+		const char *s = title.c_str(), *end = s + title.size();
+		int index = 0;
+		while (s < end)
+		{
+			unsigned int ch;
+			const int len = ImTextCharFromUtf8(&ch, s, end);
+			if (len <= 0)
+				break;
+			const std::string glyph(s, len);
+			const float e = easeOut((age - index * .018f) / .35f);
+			const float w = textWidth(display, fs, glyph);
+			dl->AddText(display, fs, ImVec2(x, y0 + (1 - e) * f.h * .025f), IM_COL32(255, 255, 255, (int)(255 * e * alpha)), glyph.c_str());
+			x += w;
+			s += len;
+			index++;
+		}
+		// details: format, region, serial
+		std::string info = g.format;
+		if (!g.regionName.empty())
+			info += "   \xC2\xB7   " + g.regionName;
+		if (!g.e.productId.empty())
+			info += "   \xC2\xB7   " + g.e.productId;
+		const float ia = alpha * easeOut((age - .15f) / .4f);
+		drawText(dl, bodyFont(), f.h * .026f, ImVec2(x0, y0 + size * 1.25f), mix(g.c1, { 1, 1, 1 }, .45f).u32(.9f * ia), info, .5f);
+
+		// position in the library
+		char count[32];
+		snprintf(count, sizeof(count), "%02d / %02d", f.sel + 1, (int)f.games->size());
+		drawText(dl, display, f.h * .02f, ImVec2(f.w * .05f, f.h * .935f - f.h * .012f), IM_COL32(200, 205, 220, (int)(170 * alpha)), count);
+	}
+
+	bool started = false;
+	float pos = 0, vel = 0, spin = 0;
+	Color bg1 { .4f, .5f, 1.f }, bg2 { .05f, .06f, .14f };
+};
+
+} // namespace
+
+std::unique_ptr<Theme> makeOrbit() {
+	return std::make_unique<Orbit>();
+}
+
+} // namespace launcher
diff --git a/shell/ps4/launcher/theme_shelf.cpp b/shell/ps4/launcher/theme_shelf.cpp
new file mode 100644
index 000000000..b12517d63
--- /dev/null
+++ b/shell/ps4/launcher/theme_shelf.cpp
@@ -0,0 +1,267 @@
+/*
+	DeCast-S4 launcher, theme "Shelf": box art standing on a glossy shelf in perspective. The
+	selected box faces you and the others turn away on either side; starting a game turns the box
+	around to its back.
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "launcher_internal.h"
+
+#include <algorithm>
+#include <ctime>
+
+namespace launcher
+{
+namespace
+{
+
+class Shelf : public Theme
+{
+public:
+	const char *name() const override { return "Shelf"; }
+	float launchSeconds() const override { return 1.6f; }
+
+	void draw(Frame& f) override
+	{
+		std::vector<Game>& games = *f.games;
+		const int n = (int)games.size();
+		if (!started)
+		{
+			started = true;
+			pos = (float)f.goal;
+			if (n > 0)
+				light = games[f.sel].c1;
+		}
+		spring(pos, vel, (float)f.goal, 140.f, 24.f, f.dt);
+		if (n > 0)
+			approach(light, games[f.sel].c1, 2.5f, f.dt);
+		const float launch = f.launchAt >= 0 ? clamp01((f.t - f.launchAt) / launchSeconds()) : 0.f;
+
+		cx = f.w * .5f;
+		cy = f.h * .42f;
+		size = f.h * .42f;
+		dist = size * 2.6f;
+		drawRoom(f);
+		if (n == 0)
+		{
+			drawEmptyLibrary(f);
+			drawHints(f);
+			return;
+		}
+
+		struct Item { int game; float k; };
+		std::vector<Item> items;
+		const int span = std::min(7, n - 1);
+		for (int i = (int)std::floor(pos) - span - 1; i <= (int)std::ceil(pos) + span + 1; i++)
+		{
+			const float k = i - pos;
+			if (std::fabs(k) > span + .5f || (n == 1 && i != f.goal))
+				continue;
+			items.push_back({ ((i % n) + n) % n, k });
+		}
+		// far boxes first
+		std::sort(items.begin(), items.end(), [](const Item& a, const Item& b) { return std::fabs(a.k) > std::fabs(b.k); });
+		const float out = easeOut(launch / .5f);
+		for (const Item& it : items)
+		{
+			const bool front = std::fabs(it.k) < .5f;
+			Pose p = poseFor(it.k);
+			float alpha = clamp01(span + .5f - std::fabs(it.k));
+			if (front)
+			{
+				// turn around and come forward
+				const float q = clamp01(launch / .55f);
+				p.angle += PI * q * q * (3 - 2 * q);
+				p.z -= size * .9f * out;
+			}
+			else
+			{
+				p.x += (it.k < 0 ? -1 : 1) * f.w * .6f * out;
+				alpha *= 1 - out;
+			}
+			drawBox(f, games[it.game], p, alpha, true);
+			drawBox(f, games[it.game], p, alpha, false);
+		}
+
+		const float uiAlpha = 1 - easeOut(launch / .3f);
+		drawInfo(f, games[f.sel], uiAlpha);
+		drawHints(f, uiAlpha);
+		if (launch > .78f)
+			f.dl->AddRectFilled(ImVec2(0, 0), ImVec2(f.w, f.h), IM_COL32(0, 0, 0, (int)(255 * clamp01((launch - .78f) / .22f))));
+	}
+
+private:
+	struct Pose { float x, z, angle; };
+
+	// Where a box k places from the selection stands, and how far it is turned
+	Pose poseFor(float k) const
+	{
+		const float s = std::fmax(-1.f, std::fmin(1.f, k));
+		const float a = std::fabs(k);
+		Pose p;
+		p.angle = -s * 1.2f;		// ~70 degrees, facing the middle
+		p.x = a < 1 ? k * size * .8f : (k < 0 ? -1 : 1) * (size * .8f + (a - 1) * size * .26f);
+		p.z = std::fabs(s) * size * .6f;
+		return p;
+	}
+
+	ImVec2 project(float x, float y, float z) const
+	{
+		const float s = dist / (dist + z);
+		return ImVec2(cx + x * s, cy + y * s);
+	}
+
+	// The box (or its reflection in the shelf) as vertical strips, so the perspective holds
+	void drawBox(Frame& f, const Game& g, const Pose& p, float alpha, bool reflection)
+	{
+		if (alpha <= .003f)
+			return;
+		const float ca = std::cos(p.angle), sa = std::sin(p.angle);
+		const bool back = ca < 0;
+		const ImTextureID tex = back ? ImTextureID() : coverTexture(g);
+		const float half = size * .5f;
+		constexpr int STRIPS = 12;
+		// facing light: boxes turned away are darker
+		const float shade = .45f + .55f * std::fabs(ca);
+		for (int i = 0; i < STRIPS; i++)
+		{
+			const float u0 = (float)i / STRIPS, u1 = (float)(i + 1) / STRIPS;
+			const float lx0 = -half + u0 * size, lx1 = -half + u1 * size;
+			const float x0 = p.x + lx0 * ca, z0 = p.z + lx0 * sa, x1 = p.x + lx1 * ca, z1 = p.z + lx1 * sa;
+			// from the back the picture reads mirrored
+			const float tu0 = back ? 1 - u0 : u0, tu1 = back ? 1 - u1 : u1;
+			ImVec2 q[4], uv[4];
+			ImU32 col[4];
+			if (!reflection)
+			{
+				q[0] = project(x0, -half, z0); q[1] = project(x1, -half, z1);
+				q[2] = project(x1, half, z1); q[3] = project(x0, half, z0);
+				uv[0] = ImVec2(tu0, 0); uv[1] = ImVec2(tu1, 0); uv[2] = ImVec2(tu1, 1); uv[3] = ImVec2(tu0, 1);
+				// a sheen sweeping across the front box
+				for (int c = 0; c < 4; c++)
+				{
+					const float u = (c == 0 || c == 3) ? u0 : u1;
+					const float sweep = std::exp(-std::pow((u - std::fmod(f.t * .18f, 1.6f) + .3f) * 5.f, 2.f)) * .25f * std::fabs(ca);
+					const float v = std::fmin(1.f, shade + sweep);
+					col[c] = tex != ImTextureID() ? Color { v, v, v }.u32(alpha)
+							: mix(back ? g.c2 : g.c1, g.c2, c >= 2 ? .8f : .1f + .3f * u).u32(alpha * shade);
+				}
+			}
+			else
+			{
+				// mirrored below the shelf, fading out
+				const float depth = size * .55f;
+				q[0] = project(x0, half, z0); q[1] = project(x1, half, z1);
+				q[2] = project(x1, half + depth, z1); q[3] = project(x0, half + depth, z0);
+				uv[0] = ImVec2(tu0, 1); uv[1] = ImVec2(tu1, 1); uv[2] = ImVec2(tu1, 1 - depth / size); uv[3] = ImVec2(tu0, 1 - depth / size);
+				const Color base = tex != ImTextureID() ? Color { shade, shade, shade } : mix(g.c1, g.c2, .5f);
+				col[0] = col[1] = base.u32(alpha * .28f);
+				col[2] = col[3] = base.u32(0.f);
+			}
+			drawQuad(f.dl, tex, q, uv, col);
+		}
+		if (reflection)
+			return;
+		// edges: a thin bright rim on the front, the back panel's text once it faces us
+		const ImVec2 tl = project(p.x - half * ca, -half, p.z - half * sa), tr = project(p.x + half * ca, -half, p.z + half * sa);
+		const ImVec2 br = project(p.x + half * ca, half, p.z + half * sa), bl = project(p.x - half * ca, half, p.z - half * sa);
+		f.dl->AddQuad(tl, tr, br, bl, IM_COL32(255, 255, 255, (int)(60 * alpha * std::fabs(ca))), 1.5f);
+		if (back && ca < -.85f)
+		{
+			const float a = alpha * clamp01((-ca - .85f) / .15f);
+			const ImVec2 c((tl.x + br.x) / 2, (tl.y + br.y) / 2);
+			const float w = std::fabs(tr.x - tl.x);
+			drawText(f.dl, displayFont(), w * .07f, ImVec2(c.x, c.y - w * .12f), IM_COL32(255, 255, 255, (int)(255 * a)), g.e.title, .5f, w * .86f);
+			drawText(f.dl, bodyFont(), w * .045f, ImVec2(c.x, c.y), IM_COL32(220, 225, 235, (int)(220 * a)), "Starting...", .5f);
+			drawText(f.dl, bodyFont(), w * .035f, ImVec2(c.x, c.y + w * .3f), IM_COL32(200, 205, 220, (int)(180 * a)),
+					g.format + (g.e.productId.empty() ? "" : "   " + g.e.productId), .5f);
+		}
+	}
+
+	void drawRoom(Frame& f)
+	{
+		ImDrawList *dl = f.dl;
+		const float shelfY = cy + size * .5f;
+		const Color top = mix(light, { 0, 0, 0 }, .88f);
+		dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(f.w, shelfY), top.u32(), top.u32(), IM_COL32(6, 6, 9, 255), IM_COL32(6, 6, 9, 255));
+		dl->AddRectFilledMultiColor(ImVec2(0, shelfY), ImVec2(f.w, f.h), IM_COL32(14, 14, 18, 255), IM_COL32(14, 14, 18, 255),
+				IM_COL32(2, 2, 3, 255), IM_COL32(2, 2, 3, 255));
+		// spot lights from above, swaying a little
+		for (int i = 0; i < 3; i++)
+		{
+			const float x = f.w * (.5f + (i - 1) * .34f) + std::sin(f.t * .3f + i * 2) * f.w * .02f;
+			drawBlob(dl, ImVec2(x, cy - size * .2f), size * (i == 1 ? 1.5f : 1.f), light.u32(i == 1 ? .2f : .09f));
+		}
+		// the shelf's front edge catching the light
+		dl->AddRectFilledMultiColor(ImVec2(0, shelfY - 1), ImVec2(f.w, shelfY + 2), IM_COL32(255, 255, 255, 0), light.u32(.35f),
+				light.u32(.35f), IM_COL32(255, 255, 255, 0));
+		dl->AddRectFilledMultiColor(ImVec2(f.w * .5f, shelfY - 1), ImVec2(f.w, shelfY + 2), light.u32(.35f), IM_COL32(255, 255, 255, 0),
+				IM_COL32(255, 255, 255, 0), light.u32(.35f));
+		// dust in the light
+		u32 x = 88172645u;
+		for (int i = 0; i < 50; i++)
+		{
+			x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+			const float px = (x & 0xffff) / 65535.f * f.w, base = (x >> 16) / 65535.f;
+			const float py = std::fmod(base * f.h * .8f - f.t * (6.f + i % 5), f.h * .8f);
+			const float a = .5f + .5f * std::sin(f.t * .7f + i);
+			dl->AddCircleFilled(ImVec2(px + std::sin(f.t * .4f + i) * 10.f, py < 0 ? py + f.h * .8f : py), 1.4f, light.u32(.25f * a), 6);
+		}
+	}
+
+	void drawInfo(Frame& f, const Game& g, float alpha)
+	{
+		if (alpha <= 0)
+			return;
+		ImDrawList *dl = f.dl;
+		const float age = f.t - f.selectedAt;
+		const float in = alpha * easeOut(age / .35f);
+		const float y = f.h * .8f;
+		drawText(dl, displayFont(), f.h * .045f, ImVec2(f.w / 2, y + (1 - in) * 8), IM_COL32(255, 255, 255, (int)(255 * in)), g.e.title, .5f, f.w * .8f);
+		std::string info = g.format;
+		if (!g.regionName.empty())
+			info += "   \xC2\xB7   " + g.regionName;
+		if (!g.e.productId.empty())
+			info += "   \xC2\xB7   " + g.e.productId;
+		drawText(dl, bodyFont(), f.h * .025f, ImVec2(f.w / 2, y + f.h * .06f), mix(g.c1, { 1, 1, 1 }, .5f).u32(.85f * in), info, .5f);
+		// where you are on the shelf
+		const int n = (int)f.games->size();
+		if (n > 1)
+		{
+			const float x0 = f.w * .35f, x1 = f.w * .65f, ly = f.h * .055f;
+			dl->AddLine(ImVec2(x0, ly), ImVec2(x1, ly), IM_COL32(255, 255, 255, (int)(50 * alpha)), 2.f);
+			const float p = ((std::fmod(pos, (float)n) + n) / n) - std::floor((std::fmod(pos, (float)n) + n) / n);
+			dl->AddCircleFilled(ImVec2(x0 + (x1 - x0) * p, ly), 5.f, light.u32(alpha));
+		}
+		char clock[16];
+		const time_t now = time(nullptr);
+		strftime(clock, sizeof(clock), "%H:%M", localtime(&now));
+		drawText(dl, displayFont(), f.h * .026f, ImVec2(f.w * .95f, f.h * .04f), IM_COL32(255, 255, 255, (int)(220 * alpha)), clock, 1.f);
+	}
+
+	bool started = false;
+	float pos = 0, vel = 0;
+	float cx = 0, cy = 0, size = 0, dist = 1;
+	Color light { .5f, .6f, 1.f };
+};
+
+} // namespace
+
+std::unique_ptr<Theme> makeShelf() {
+	return std::make_unique<Shelf>();
+}
+
+} // namespace launcher
diff --git a/shell/ps4/launcher/theme_xmb.cpp b/shell/ps4/launcher/theme_xmb.cpp
new file mode 100644
index 000000000..4aa3a060d
--- /dev/null
+++ b/shell/ps4/launcher/theme_xmb.cpp
@@ -0,0 +1,368 @@
+/*
+	DeCast-S4 launcher, theme "Cross bar": categories across, items down, over slow light ribbons
+	that take the selected game's colour. Settings and the theme choice live in the bar too.
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
