+	ORBIS_PAD_BUTTON_CROSS, ORBIS_PAD_BUTTON_CIRCLE, ORBIS_PAD_BUTTON_SQUARE, ORBIS_PAD_BUTTON_TRIANGLE,
+	ORBIS_PAD_BUTTON_UP, ORBIS_PAD_BUTTON_DOWN, ORBIS_PAD_BUTTON_LEFT, ORBIS_PAD_BUTTON_RIGHT,
+	ORBIS_PAD_BUTTON_L1, ORBIS_PAD_BUTTON_R1, ORBIS_PAD_BUTTON_L3, ORBIS_PAD_BUTTON_R3,
+	ORBIS_PAD_BUTTON_OPTIONS, ORBIS_PAD_BUTTON_TOUCH_PAD,
+};
+
+std::vector<std::shared_ptr<PS4Gamepad>> gamepads;
+int firstHandle = -1;
+u32 rescanCountdown = 0;
+
+int stickValue(u8 v) {
+	return std::clamp(((int)v - 128) * 256, -32768, 32767);
+}
+
+// Triggers (InputMapping::addTrigger): -32768 released .. 32767 fully pressed.
+int triggerValue(u8 v) {
+	return (int)v * 257 - 32768;
+}
+
+template<bool Arcade = false, bool Gamepad = false>
+class DefaultInputMapping : public InputMapping
+{
+public:
+	DefaultInputMapping()
+	{
+		using namespace ps4pad;
+		name = Arcade ? Gamepad ? "Arcade Gamepad" : "Arcade Hitbox" : "Default";
+		if (Arcade)
+		{
+			if (Gamepad)
+			{
+				// 1  2  3  4  5  6
+				// X  O  []  /\ L1 R1
+				set_button(DC_BTN_A, ORBIS_PAD_BUTTON_CROSS);
+				set_button(DC_BTN_B, ORBIS_PAD_BUTTON_CIRCLE);
+				set_button(DC_BTN_C, ORBIS_PAD_BUTTON_SQUARE);
+				set_button(DC_BTN_X, ORBIS_PAD_BUTTON_TRIANGLE);
+				set_button(DC_BTN_Y, ORBIS_PAD_BUTTON_L1);
+				set_button(DC_BTN_Z, ORBIS_PAD_BUTTON_R1);
+				set_axis(DC_AXIS_LT, AXIS_L2, true);
+				set_axis(DC_AXIS_RT, AXIS_R2, true);
+			}
+			else
+			{
+				// Hitbox
+				// 1  2  3  4  5  6  7  8
+				// [] /\ R1 X  O  R2 L1 L2
+				set_button(DC_BTN_A, ORBIS_PAD_BUTTON_SQUARE);
+				set_button(DC_BTN_B, ORBIS_PAD_BUTTON_TRIANGLE);
+				set_button(DC_BTN_C, ORBIS_PAD_BUTTON_R1);
+				set_button(DC_BTN_X, ORBIS_PAD_BUTTON_CROSS);
+				set_button(DC_BTN_Y, ORBIS_PAD_BUTTON_CIRCLE);
+				set_axis(DC_BTN_Z, AXIS_R2, true);
+				set_button(DC_DPAD2_LEFT, ORBIS_PAD_BUTTON_L1);	// L1 (Naomi button 7)
+				set_axis(DC_DPAD2_RIGHT, AXIS_L2, true);		// L2 (Naomi button 8)
+			}
+		}
+		else
+		{
+			set_button(DC_BTN_A, ORBIS_PAD_BUTTON_CROSS);
+			set_button(DC_BTN_B, ORBIS_PAD_BUTTON_CIRCLE);
+			set_button(DC_BTN_X, ORBIS_PAD_BUTTON_SQUARE);
+			set_button(DC_BTN_Y, ORBIS_PAD_BUTTON_TRIANGLE);
+			set_button(DC_BTN_C, ORBIS_PAD_BUTTON_R1);
+			set_button(DC_BTN_Z, ORBIS_PAD_BUTTON_L1);
+			set_axis(DC_AXIS_LT, AXIS_L2, true);
+			set_axis(DC_AXIS_RT, AXIS_R2, true);
+		}
+		set_button(DC_BTN_START, ORBIS_PAD_BUTTON_OPTIONS);
+		set_button(DC_DPAD_UP, ORBIS_PAD_BUTTON_UP);
+		set_button(DC_DPAD_DOWN, ORBIS_PAD_BUTTON_DOWN);
+		set_button(DC_DPAD_LEFT, ORBIS_PAD_BUTTON_LEFT);
+		set_button(DC_DPAD_RIGHT, ORBIS_PAD_BUTTON_RIGHT);
+		// the touchpad click opens Flycast's menu (the Share and PS buttons belong to the system)
+		set_button(EMU_BTN_MENU, ORBIS_PAD_BUTTON_TOUCH_PAD);
+
+		set_axis(DC_AXIS_LEFT, AXIS_LX, false);
+		set_axis(DC_AXIS_RIGHT, AXIS_LX, true);
+		set_axis(DC_AXIS_UP, AXIS_LY, false);
+		set_axis(DC_AXIS_DOWN, AXIS_LY, true);
+		set_axis(DC_AXIS2_LEFT, AXIS_RX, false);
+		set_axis(DC_AXIS2_RIGHT, AXIS_RX, true);
+		set_axis(DC_AXIS2_UP, AXIS_RY, false);
+		set_axis(DC_AXIS2_DOWN, AXIS_RY, true);
+		addTrigger(AXIS_L2, false);
+		addTrigger(AXIS_R2, false);
+
+		dirty = false;
+	}
+};
+
+bool portInUse(int port)
+{
+	for (const auto& pad : gamepads)
+		if (pad->maple_port() == port)
+			return true;
+	return false;
+}
+
+bool userHasPad(int userId)
+{
+	for (const auto& pad : gamepads)
+		if (pad->userId() == userId)
+			return true;
+	return false;
+}
+
+void openPad(int userId)
+{
+	int handle = scePadOpen(userId, ORBIS_PAD_PORT_TYPE_STANDARD, 0, nullptr);
+	if (handle < 0)
+	{
+		// one handle per user and pad: an earlier open in this process may still own it
+		const int error = handle;
+		handle = scePadGetHandle(userId, ORBIS_PAD_PORT_TYPE_STANDARD, 0);
+		if (handle < 0)
+		{
+			WARN_LOG(INPUT, "PS4: scePadOpen(user %x) failed: %x", userId, error);
+			return;
+		}
+		INFO_LOG(INPUT, "PS4: reusing pad handle %d of user %x", handle, userId);
+	}
+	int port = 0;
+	while (port < 4 && portInUse(port))
+		port++;
+	if (port == 4)
+	{
+		scePadClose(handle);
+		return;
+	}
+	if (firstHandle < 0)
+		firstHandle = handle;
+	auto pad = std::make_shared<PS4Gamepad>(port, userId, handle);
+	gamepads.push_back(pad);
+	GamepadDevice::Register(pad);
+}
+
+void scanUsers()
+{
+	OrbisUserServiceLoginUserIdList list{};
+	if (sceUserServiceGetLoginUserIdList(&list) != 0)
+		return;
+	// the initial user first, so they get port A
+	int initial = -1;
+	sceUserServiceGetInitialUser(&initial);
+	if (initial >= 0 && !userHasPad(initial))
+		openPad(initial);
+	for (int userId : list.userId)
+		if (userId >= 0 && userId != 0xFF && !userHasPad(userId))
+			openPad(userId);
+}
+
+} // namespace
+
+PS4Gamepad::PS4Gamepad(int maple_port, int userId, int handle)
+	: GamepadDevice(maple_port, "PS4"), user(userId), padHandle(handle)
+{
+	char userName[32]{};
+	if (sceUserServiceGetUserName(userId, userName, sizeof(userName)) == 0 && userName[0] != '\0')
+		_name = std::string("DualShock 4 (") + userName + ")";
+	else
+		_name = "DualShock 4";
+	_unique_id = "ps4_dualshock4_" + std::to_string(maple_port);
+	std::fill(std::begin(lastAxes), std::end(lastAxes), 0);
+	lastAxes[ps4pad::AXIS_L2] = lastAxes[ps4pad::AXIS_R2] = triggerValue(0);
+
+	OrbisPadInformation info{};
+	if (scePadGetControllerInformation(handle, &info) == 0 && info.touchResolutionX > 1)
+		touchMaxX = (float)(info.touchResolutionX - 1);
+
+	hasAnalogStick = true;
+	rumbleEnabled = true;
+	loadMapping();
+	// mappings saved by an older version may lack the trigger axes
+	input_mapper->addTrigger(ps4pad::AXIS_L2, false);
+	input_mapper->addTrigger(ps4pad::AXIS_R2, false);
+	NOTICE_LOG(INPUT, "PS4: %s on port %d (user %x, handle %d)", _name.c_str(), maple_port, userId, handle);
+}
+
+PS4Gamepad::~PS4Gamepad()
+{
+	setVibration(0, 0);
+	scePadClose(padHandle);
+}
+
+bool PS4Gamepad::update()
+{
+	OrbisPadData data{};
+	if (scePadReadState(padHandle, &data) != 0)
+		return true;	// no new state: keep the last one
+	if (!data.connected)
+	{
+		// release everything, the pad may come back
+		if (lastButtons != 0)
+		{
+			for (u32 button : kButtons)
+				if (lastButtons & button)
+					gamepad_btn_input(button, false);
+			lastButtons = 0;
+		}
+		return true;
+	}
+
+	const u32 buttons = data.buttons;
+	const u32 changed = buttons ^ lastButtons;
+	if (changed != 0)
+		for (u32 button : kButtons)
+			if (changed & button)
+				gamepad_btn_input(button, (buttons & button) != 0);
+	lastButtons = buttons;
+
+	const int axes[ps4pad::AXIS_COUNT] = {
+		stickValue(data.leftStick.x), stickValue(data.leftStick.y),
+		stickValue(data.rightStick.x), stickValue(data.rightStick.y),
+		triggerValue(data.analogButtons.l2), triggerValue(data.analogButtons.r2),
+	};
+	for (u32 axis = 0; axis < ps4pad::AXIS_COUNT; axis++)
+		if (axes[axis] != lastAxes[axis])
+		{
+			gamepad_axis_input(axis, axes[axis]);
+			lastAxes[axis] = axes[axis];
+		}
+	return true;
+}
+
+const char *PS4Gamepad::get_button_name(u32 code)
+{
+	using namespace i18n;
+	switch (code)
+	{
+	case ORBIS_PAD_BUTTON_CROSS: return T("Cross");
+	case ORBIS_PAD_BUTTON_CIRCLE: return T("Circle");
+	case ORBIS_PAD_BUTTON_SQUARE: return T("Square");
+	case ORBIS_PAD_BUTTON_TRIANGLE: return T("Triangle");
+	case ORBIS_PAD_BUTTON_UP: return T("DPad Up");
+	case ORBIS_PAD_BUTTON_DOWN: return T("DPad Down");
+	case ORBIS_PAD_BUTTON_LEFT: return T("DPad Left");
+	case ORBIS_PAD_BUTTON_RIGHT: return T("DPad Right");
+	case ORBIS_PAD_BUTTON_L1: return "L1";
+	case ORBIS_PAD_BUTTON_R1: return "R1";
+	case ORBIS_PAD_BUTTON_L3: return "L3";
+	case ORBIS_PAD_BUTTON_R3: return "R3";
+	case ORBIS_PAD_BUTTON_OPTIONS: return T("Options");
+	case ORBIS_PAD_BUTTON_TOUCH_PAD: return T("Touchpad");
+	default: return nullptr;
+	}
+}
+
+const char *PS4Gamepad::get_axis_name(u32 code)
+{
+	using namespace i18n;
+	switch (code)
+	{
+	case ps4pad::AXIS_LX: return T("Left Stick X");
+	case ps4pad::AXIS_LY: return T("Left Stick Y");
+	case ps4pad::AXIS_RX: return T("Right Stick X");
+	case ps4pad::AXIS_RY: return T("Right Stick Y");
+	case ps4pad::AXIS_L2: return "L2";
+	case ps4pad::AXIS_R2: return "R2";
+	default: return nullptr;
+	}
+}
+
+std::shared_ptr<InputMapping> PS4Gamepad::getDefaultMapping() {
+	return std::make_shared<DefaultInputMapping<>>();
+}
+
+void PS4Gamepad::resetMappingToDefault(bool arcade, bool gamepad)
+{
+	if (arcade)
+	{
+		if (gamepad)
+			input_mapper = std::make_shared<DefaultInputMapping<true, true>>();
+		else
+			input_mapper = std::make_shared<DefaultInputMapping<true, false>>();
+	}
+	else
+		input_mapper = std::make_shared<DefaultInputMapping<false, false>>();
+}
+
+void PS4Gamepad::setVibration(u8 large, u8 small)
+{
+	const OrbisPadVibeParam param{large, small};
+	scePadSetVibration(padHandle, &param);
+}
+
+void PS4Gamepad::rumble(float power, float inclination, u32 duration_ms)
+{
+	if (!rumbleEnabled)
+		return;
+	power = std::clamp(power * rumblePower / 100.f, 0.f, 1.f);
+	// the inclination moves the feel from the big (low) motor to the small (high) one
+	const float high = std::clamp(0.5f + inclination * 0.5f, 0.f, 1.f);
+	setVibration((u8)std::lround(power * (1.f - high) * 255.f), (u8)std::lround(power * high * 255.f));
+	vibStopTime = power != 0.f ? getTimeMs() + duration_ms : 0;
+}
+
+void PS4Gamepad::update_rumble()
+{
+	if (vibStopTime != 0 && getTimeMs() >= vibStopTime)
+	{
+		setVibration(0, 0);
+		vibStopTime = 0;
+	}
+}
+
+void input_ps4_init()
+{
+	sceUserServiceInitialize(nullptr);
+	const int result = scePadInit();
+	if (result != 0)
+		WARN_LOG(INPUT, "PS4: scePadInit failed: %x", result);
+	scanUsers();
+	rescanCountdown = 120;
+}
+
+void input_ps4_handle()
+{
+	for (auto& pad : gamepads)
+	{
+		pad->update();
+		pad->update_rumble();
+	}
+	// users signing in while the app runs (about every 2 s)
+	if (--rescanCountdown == 0)
+	{
+		rescanCountdown = 120;
+		scanUsers();
+	}
+}
+
+void input_ps4_term()
+{
+	for (auto& pad : gamepads)
+		GamepadDevice::Unregister(pad);
+	gamepads.clear();
+	firstHandle = -1;
+}
+
+int ps4_first_pad_handle() {
+	return firstHandle;
+}
+
+bool ps4_pad_state(u32& buttons, float& lx, float& ly)
+{
+	for (const auto& pad : gamepads)
+		if (pad->maple_port() == 0)
+		{
+			buttons = pad->buttons();
+			lx = pad->axis(ps4pad::AXIS_LX) / 32768.f;
+			ly = pad->axis(ps4pad::AXIS_LY) / 32768.f;
+			return true;
+		}
+	buttons = 0;
+	lx = ly = 0.f;
+	return false;
+}
