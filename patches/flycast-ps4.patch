+
+Theme *makeTheme(int index)
+{
+	switch (index)
+	{
+	case 1: return makeChannel().release();
+	case 2: return makeShelf().release();
+	case 3: return makeCrossBar().release();
+	default: return makeOrbit().release();
+	}
+}
+
+std::string upper(std::string s)
+{
+	for (char& c : s)
+		c = (char)toupper((unsigned char)c);
+	return s;
+}
+
+void paletteWorker()
+{
+	ThreadName _("LauncherCovers");
+	for (;;)
+	{
+		std::string path;
+		{
+			std::unique_lock<std::mutex> lock(gPaletteMutex);
+			gPaletteCv.wait_for(lock, std::chrono::milliseconds(500), [] { return !gPaletteQueue.empty(); });
+			if (gPaletteQueue.empty())
+				continue;
+			path = gPaletteQueue.front();
+			gPaletteQueue.pop_front();
+		}
+		Color a, b;
+		if (paletteFromImage(path, a, b))
+		{
+			std::lock_guard<std::mutex> lock(gPaletteMutex);
+			gPalettes[path] = { a, b };
+		}
+	}
+}
+
+// Colours from the title until (or unless) the cover has been read.
+void titlePalette(Game& g)
+{
+	u32 h = 2166136261u;
+	for (char c : g.e.title)
+		h = (h ^ (u8)c) * 16777619u;
+	const float hue = (h % 360) / 360.f;
+	g.c1 = hsv(hue, .62f, .98f);
+	g.c2 = hsv(hue, .72f, .2f);
+}
+
+void refreshLibrary()
+{
+	std::vector<LauncherEntry> entries;
+	gui_ps4_list_games(entries);
+	std::unordered_map<std::string, Game> old;
+	for (auto& g : gGames)
+		old.emplace(g.e.path, g);
+	std::vector<Game> games;
+	games.reserve(entries.size());
+	for (auto& e : entries)
+	{
+		Game g;
+		auto it = old.find(e.path);
+		if (it != old.end())
+			g = it->second;
+		g.e = e;
+		const std::string own = userCover(e);
+		g.cover = own.empty() ? e.coverPath : own;
+		g.format = upper(get_file_extension(e.fileName));
+		g.regionName = (e.region & 4) && !(e.region & 3) ? "Europe" : (e.region & 1) && !(e.region & 6) ? "Japan"
+				: (e.region & 2) ? "USA" : "";
+		if (it == old.end())
+			titlePalette(g);
+		if (!g.cover.empty())
+		{
+			std::lock_guard<std::mutex> lock(gPaletteMutex);
+			auto p = gPalettes.find(g.cover);
+			if (p != gPalettes.end())
+			{
+				g.c1 = p->second.first;
+				g.c2 = p->second.second;
+				g.paletteFromCover = true;
+			}
+			else if (std::find(gPaletteQueue.begin(), gPaletteQueue.end(), g.cover) == gPaletteQueue.end())
+			{
+				gPaletteQueue.push_back(g.cover);
+				gPaletteCv.notify_one();
+			}
+		}
+		games.push_back(std::move(g));
+	}
+	std::sort(games.begin(), games.end(), [](const Game& a, const Game& b) {
+		return strcasecmp(a.e.title.c_str(), b.e.title.c_str()) < 0;
+	});
+	gGames = std::move(games);
+	// keep the same game selected when the list changes
+	int found = -1;
+	for (int i = 0; i < (int)gGames.size(); i++)
+		if (gGames[i].e.path == gSelectedPath)
+			found = i;
+	if (found >= 0 && found != gSel)
+	{
+		gGoal += found - gSel;
+		gSel = found;
+	}
+	if (gGames.empty())
+		gSel = gGoal = 0;
+	else
+		gSel = std::clamp(gSel, 0, (int)gGames.size() - 1);
+}
+
+void setTheme(int index)
+{
+	index = ((index % THEME_COUNT) + THEME_COUNT) % THEME_COUNT;
+	gTheme.reset(makeTheme(index));
+	gThemeIndex = index;
+	config::saveInt("decast", "LauncherTheme", index);
+}
+
+Frame makeFrame()
+{
+	ImGuiIO& io = ImGui::GetIO();
+	Frame f;
+	f.dl = ImGui::GetBackgroundDrawList();
+	f.w = io.DisplaySize.x;
+	f.h = io.DisplaySize.y;
+	f.t = gTime;
+	f.dt = std::min(.05f, io.DeltaTime);
+	f.games = &gGames;
+	f.sel = gSel;
+	f.goal = gGoal;
+	f.selectedAt = gSelectedAt;
+	f.launchAt = gLaunchAt;
+	return f;
+}
+
+void handleInput(Frame& f)
+{
+	u32 buttons = 0;
+	float lx = 0, ly = 0;
+	ps4_pad_state(buttons, lx, ly);
+	// back from Settings or a game: buttons still held from there aren't new presses here
+	static int lastFrame = -10;
+	const int frame = ImGui::GetFrameCount();
+	if (frame != lastFrame + 1)
+	{
+		gPrevButtons = buttons;
+		gHeldDir = -1;
+	}
+	lastFrame = frame;
+	const u32 pressed = buttons & ~gPrevButtons;
+	gPrevButtons = buttons;
+	if (gLaunchAt >= 0 || gPendingTheme >= 0)
+		return;
+
+	// direction: d-pad or the left stick, with key repeat
+	int dir = 0;	// 1 left, 2 right, 3 up, 4 down
+	if ((buttons & ORBIS_PAD_BUTTON_LEFT) || lx < -.55f) dir = 1;
+	else if ((buttons & ORBIS_PAD_BUTTON_RIGHT) || lx > .55f) dir = 2;
+	else if ((buttons & ORBIS_PAD_BUTTON_UP) || ly < -.55f) dir = 3;
+	else if ((buttons & ORBIS_PAD_BUTTON_DOWN) || ly > .55f) dir = 4;
+	bool fire = false;
+	// a direction held across the return waits for its release
+	if (gHeldDir == -1 && dir != 0)
+		return;
+	if (dir != gHeldDir)
+	{
+		gHeldDir = dir;
+		fire = dir != 0;
+		gRepeatAt = gTime + .38f;
+	}
+	else if (dir != 0 && gTime >= gRepeatAt)
+	{
+		fire = true;
+		gRepeatAt = gTime + .085f;
+	}
+	if (fire)
+	{
+		const int dx = dir == 1 ? -1 : dir == 2 ? 1 : 0;
+		const int dy = dir == 3 ? -1 : dir == 4 ? 1 : 0;
+		if (!gTheme->navigate(f, dx, dy))
+			moveSelection(dx != 0 ? dx : dy);
+	}
+	if (pressed & ORBIS_PAD_BUTTON_L1)
+		moveSelection(-5);
+	if (pressed & ORBIS_PAD_BUTTON_R1)
+		moveSelection(5);
+
+	if (pressed & ORBIS_PAD_BUTTON_CROSS)
+	{
+		if (!gTheme->activate(f))
+		{
+			if (gGames.empty())
+				playSound(Sound::Error);
+			else
+			{
+				gLaunchAt = gTime;
+				playSound(Sound::Launch);
+			}
+		}
+	}
+	if (pressed & ORBIS_PAD_BUTTON_SQUARE)
+		requestTheme(gThemeIndex + 1);
+	if (pressed & (ORBIS_PAD_BUTTON_TRIANGLE | ORBIS_PAD_BUTTON_OPTIONS | ORBIS_PAD_BUTTON_TOUCH_PAD))
+		openSettings();
+}
+} // namespace
+
+// ---- requests from themes ----
+
+void requestTheme(int index)
+{
+	if (gPendingTheme >= 0 || index == gThemeIndex)
+		return;
+	gPendingTheme = ((index % THEME_COUNT) + THEME_COUNT) % THEME_COUNT;
+	gFadeAt = gTime;
+	playSound(Sound::Category);
+}
+
+int currentTheme() {
+	return gThemeIndex;
+}
+
+void openSettings()
+{
+	playSound(Sound::Confirm);
+	gui_ps4_open_settings();
+}
+
+void moveSelection(int delta)
+{
+	if (gGames.empty() || delta == 0)
+		return;
+	const int n = (int)gGames.size();
+	gGoal += delta;
+	gSel = ((gGoal % n) + n) % n;
+	gSelectedPath = gGames[gSel].e.path;
+	gSelectedAt = gTime;
+	playSound(Sound::Move);
+}
+
+const char *themeName(int index)
+{
+	static const char *const names[] = { "Orbit", "Channel", "Shelf", "Cross bar" };
+	return names[((index % THEME_COUNT) + THEME_COUNT) % THEME_COUNT];
+}
+
+// ---- colours and maths ----
+
+Color mix(const Color& a, const Color& b, float t) {
+	return { a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t };
+}
+
+Color hsv(float h, float s, float v)
+{
+	h = (h - std::floor(h)) * 6.f;
+	const int i = (int)h;
+	const float f = h - i, p = v * (1 - s), q = v * (1 - s * f), t = v * (1 - s * (1 - f));
+	switch (i % 6)
+	{
+	case 0: return { v, t, p };
+	case 1: return { q, v, p };
+	case 2: return { p, v, t };
+	case 3: return { p, q, v };
+	case 4: return { t, p, v };
+	default: return { v, p, q };
+	}
+}
+
+void approach(Color& c, const Color& target, float rate, float dt) {
+	c = mix(c, target, 1.f - std::exp(-rate * dt));
+}
+
+float clamp01(float t) {
+	return std::fmin(1.f, std::fmax(0.f, t));
+}
+
+float easeOut(float t)
+{
+	t = clamp01(t);
+	return 1.f - (1.f - t) * (1.f - t) * (1.f - t);
+}
+
+bool reducedMotion() {
+	return false;	// the PS4 has no such setting; kept for the themes' structure
+}
+
+void spring(float& pos, float& vel, float goal, float stiffness, float damping, float dt)
+{
+	// a few sub-steps keep stiff springs stable at low frame rates
+	for (int i = 0; i < 4; i++)
+	{
+		const float h = dt / 4;
+		vel += (stiffness * (goal - pos) - damping * vel) * h;
+		pos += vel * h;
+	}
+}
+
+// ---- fonts, textures, drawing ----
+
+ImFont *displayFont() {
+	return gDisplayFont != nullptr ? gDisplayFont : bodyFont();
+}
+
+ImFont *bodyFont()
+{
+	ImGuiIO& io = ImGui::GetIO();
+	return io.FontDefault != nullptr ? io.FontDefault : io.Fonts->Fonts[0];
+}
+
+ImTextureID coverTexture(const Game& g)
+{
+	static int loadsThisFrame;
+	static float frameTime = -1;
+	if (frameTime != gTime) {
+		frameTime = gTime;
+		loadsThisFrame = 0;
+	}
+	if (g.cover.empty() || imguiDriver == nullptr)
+		return {};
+	ImTextureID id = imguiDriver->getTexture(g.cover);
+	if (id != ImTextureID() || loadsThisFrame >= 2)
+		return id;
+	loadsThisFrame++;
+	FILE *f = nowide::fopen(g.cover.c_str(), "rb");
+	if (f == nullptr)
+		return {};
+	int w, h, n;
+	u8 *data = stbi_load_from_file(f, &w, &h, &n, 4);
+	fclose(f);
+	if (data == nullptr)
+		return {};
+	try {
+		id = imguiDriver->updateTexture(g.cover, data, w, h, false);
+	} catch (...) {
+	}
+	stbi_image_free(data);
+	return id;
+}
+
+namespace
+{
+ImTextureID makeTexture(const char *name, int w, int h, const std::vector<u8>& rgba)
+{
+	if (imguiDriver == nullptr)
+		return {};
+	ImTextureID id = imguiDriver->getTexture(name);
+	if (id == ImTextureID())
+		id = imguiDriver->updateTexture(name, rgba.data(), w, h, false);
+	return id;
+}
+}
+
+ImTextureID blobTexture()
+{
+	static std::vector<u8> pixels;
+	constexpr int S = 128;
+	if (pixels.empty())
+	{
+		pixels.resize(S * S * 4);
+		for (int y = 0; y < S; y++)
+			for (int x = 0; x < S; x++)
+			{
+				const float dx = (x + .5f) / S * 2 - 1, dy = (y + .5f) / S * 2 - 1;
+				const float d = clamp01(1 - std::sqrt(dx * dx + dy * dy));
+				u8 *p = &pixels[(y * S + x) * 4];
+				p[0] = p[1] = p[2] = 255;
+				p[3] = (u8)std::lround(d * d * (3 - 2 * d) * 255);
+			}
+	}
+	return makeTexture("decast.blob", S, S, pixels);
+}
+
+ImTextureID discTexture()
+{
+	static std::vector<u8> pixels;
+	constexpr int S = 256;
+	if (pixels.empty())
+	{
+		pixels.resize(S * S * 4);
+		for (int y = 0; y < S; y++)
+			for (int x = 0; x < S; x++)
+			{
+				const float dx = (x + .5f) / S * 2 - 1, dy = (y + .5f) / S * 2 - 1;
+				const float r = std::sqrt(dx * dx + dy * dy), a = std::atan2(dy, dx);
+				// pressed-in silver: bright and dark bands around the disc, faint rings, a
+				// rainbow sheen like the data side
+				float v = .72f + .2f * std::cos(a * 2) + .06f * std::cos(a * 6 + 1.1f);
+				v += .03f * std::sin(r * 140);
+				const Color rainbow = hsv(a / (2 * PI) + r * .35f, .35f, 1.f);
+				Color c = mix({ v, v, v * 1.03f }, rainbow, .16f + .1f * std::cos(a * 2 + .6f));
+				u8 *p = &pixels[(y * S + x) * 4];
+				p[0] = (u8)std::lround(clamp01(c.r) * 255);
+				p[1] = (u8)std::lround(clamp01(c.g) * 255);
+				p[2] = (u8)std::lround(clamp01(c.b) * 255);
+				p[3] = 255;
+			}
+	}
+	return makeTexture("decast.disc", S, S, pixels);
+}
+
+ImTextureID noiseTexture()
+{
+	static std::vector<u8> pixels;
+	constexpr int W = 256, H = 144;
+	if (pixels.empty())
+	{
+		pixels.resize(W * H * 4);
+		u32 x = 0x9e3779b9;
+		for (int i = 0; i < W * H; i++)
+		{
+			x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+			const u8 v = (u8)(x & 0xff);
+			pixels[i * 4] = pixels[i * 4 + 1] = pixels[i * 4 + 2] = v;
+			pixels[i * 4 + 3] = 255;
+		}
+	}
+	return makeTexture("decast.noise", W, H, pixels);
+}
+
+ImVec2 whiteUV(ImDrawList *dl) {
+	return dl->_Data->TexUvWhitePixel;
+}
+
+void drawBlob(ImDrawList *dl, ImVec2 c, float r, ImU32 col)
+{
+	ImTextureID tex = blobTexture();
+	if (tex != ImTextureID())
+		dl->AddImage(tex, ImVec2(c.x - r, c.y - r), ImVec2(c.x + r, c.y + r), ImVec2(0, 0), ImVec2(1, 1), col);
+}
+
+void drawQuad(ImDrawList *dl, ImTextureID tex, const ImVec2 p[4], const ImVec2 uv[4], const ImU32 col[4])
+{
+	const bool textured = tex != ImTextureID();
+	if (textured)
+		dl->PushTexture(tex);
+	const ImVec2 w = whiteUV(dl);
+	dl->PrimReserve(6, 4);
+	const ImDrawIdx base = (ImDrawIdx)dl->_VtxCurrentIdx;
+	for (int i = 0; i < 4; i++)
+		dl->PrimWriteVtx(p[i], textured ? uv[i] : w, col[i]);
+	dl->PrimWriteIdx(base); dl->PrimWriteIdx(base + 1); dl->PrimWriteIdx(base + 2);
+	dl->PrimWriteIdx(base); dl->PrimWriteIdx(base + 2); dl->PrimWriteIdx(base + 3);
+	if (textured)
+		dl->PopTexture();
+}
+
+float textWidth(ImFont *font, float size, const std::string& text) {
+	return font->CalcTextSizeA(size, FLT_MAX, 0.f, text.c_str()).x;
+}
+
+float drawText(ImDrawList *dl, ImFont *font, float size, ImVec2 pos, ImU32 col, const std::string& text,
+		float align, float maxWidth)
+{
+	std::string s = text;
+	float width = textWidth(font, size, s);
+	if (maxWidth > 0 && width > maxWidth)
+	{
+		const std::string dots = "...";
+		while (!s.empty() && textWidth(font, size, s + dots) > maxWidth)
+		{
+			s.pop_back();
+			while (!s.empty() && ((u8)s.back() & 0xC0) == 0x80)	// whole UTF-8 characters
+				s.pop_back();
+		}
+		s += dots;
+		width = textWidth(font, size, s);
+	}
+	dl->AddText(font, size, ImVec2(std::round(pos.x - width * align), std::round(pos.y)), col, s.c_str());
+	return width;
+}
+
+void drawButton(ImDrawList *dl, char which, ImVec2 c, float size, float alpha)
+{
+	const float r = size * .5f, t = std::fmax(1.5f, size * .1f);
+	dl->AddCircleFilled(c, r, IM_COL32(20, 24, 34, (int)(200 * alpha)));
+	const float k = r * .48f;
+	switch (which)
+	{
+	case 'x': {
+		const ImU32 col = IM_COL32(120, 170, 255, (int)(255 * alpha));
+		dl->AddLine(ImVec2(c.x - k, c.y - k), ImVec2(c.x + k, c.y + k), col, t);
+		dl->AddLine(ImVec2(c.x - k, c.y + k), ImVec2(c.x + k, c.y - k), col, t);
+		break;
+	}
+	case 'o':
+		dl->AddCircle(c, k * 1.05f, IM_COL32(255, 100, 110, (int)(255 * alpha)), 24, t);
+		break;
+	case 's':
+		dl->AddRect(ImVec2(c.x - k * .9f, c.y - k * .9f), ImVec2(c.x + k * .9f, c.y + k * .9f),
+				IM_COL32(240, 140, 220, (int)(255 * alpha)), 0, 0, t);
+		break;
+	case 't':
+		dl->AddTriangle(ImVec2(c.x, c.y - k * 1.05f), ImVec2(c.x + k * 1.05f, c.y + k * .75f), ImVec2(c.x - k * 1.05f, c.y + k * .75f),
+				IM_COL32(90, 220, 180, (int)(255 * alpha)), t);
+		break;
+	}
+}
+
+void drawHints(Frame& f, float alpha)
+{
+	if (alpha <= 0.f)
+		return;
+	const float size = f.h * .028f, y = f.h * .935f, gap = size * .55f;
+	struct Hint { char b; std::string label; };
+	const Hint hints[] = {
+		{ 'x', "Start" }, { 's', std::string("Theme: ") + themeName(gThemeIndex) }, { 't', "Settings" },
+	};
+	ImFont *font = bodyFont();
+	const float fs = f.h * .022f;
+	float total = 0;
+	for (const Hint& h : hints)
+		total += size + gap + textWidth(font, fs, h.label) + size * 1.4f;
+	float x = f.w * .95f - total;
+	for (const Hint& h : hints)
+	{
+		drawButton(f.dl, h.b, ImVec2(x + size / 2, y), size, alpha);
+		x += size + gap;
+		x += drawText(f.dl, font, fs, ImVec2(x, y - fs * .62f), IM_COL32(220, 226, 238, (int)(230 * alpha)), h.label);
+		x += size * 1.4f;
+	}
+}
+
+void drawEmptyLibrary(Frame& f)
+{
+	drawText(f.dl, displayFont(), f.h * .045f, ImVec2(f.w / 2, f.h * .42f), IM_COL32(240, 242, 248, 255),
+			"Your library is empty", .5f);
+	drawText(f.dl, bodyFont(), f.h * .026f, ImVec2(f.w / 2, f.h * .51f), IM_COL32(170, 178, 196, 255),
+			"Copy GDI, CHD or CDI games to /data/DeCast-S4/games and they appear here.", .5f);
+}
+
+} // namespace launcher
+
+using namespace launcher;
+
+void launcher_pre_frame()
+{
+	ImGuiIO& io = ImGui::GetIO();
+	// Flycast rebuilds its font atlas when the UI scale or language changes: add Michroma back
+	if (gDisplayFont != nullptr && !io.Fonts->Fonts.contains(gDisplayFont))
+		gDisplayFont = nullptr;
+	if (gDisplayFont == nullptr && !gFontFailed)
+	{
+		FILE *f = fopen(kFontPath, "rb");
+		if (f != nullptr)
+		{
+			fclose(f);
+			ImFontConfig cfg;
+			cfg.MergeMode = false;
+			gDisplayFont = io.Fonts->AddFontFromFileTTF(kFontPath, 32.f, &cfg);
+		}
+		if (gDisplayFont == nullptr)
+		{
+			gFontFailed = true;
+			ps4_boot_trace("launcher: display font missing, using Flycast's");
+		}
+	}
+}
+
+bool launcher_draw()
+{
+	if (imguiDriver == nullptr)
+		return false;
+	const auto now = std::chrono::steady_clock::now();
+	static bool started;
+	if (!started)
+	{
+		started = true;
+		gLast = now;
+		setTheme(config::loadInt("decast", "LauncherTheme", 0));
+		if (!gPaletteThread)
+		{
+			gPaletteThread = true;
+			std::thread(paletteWorker).detach();
+		}
+		ps4_boot_trace("launcher: home screen up");
+	}
+	gTime += std::min(.05f, std::chrono::duration<float>(now - gLast).count());
+	gLast = now;
+	soundStart();
+
+	if (gTime >= gNextRefresh)
+	{
+		refreshLibrary();
+		gNextRefresh = gTime + .5f;
+	}
+
+	Frame f = makeFrame();
+	handleInput(f);
+	f = makeFrame();
+
+	// theme switch: 0.22 s fade out, swap, 0.22 s fade in
+	float fade = 0.f;
+	if (gPendingTheme >= 0)
+	{
+		const float p = (gTime - gFadeAt) / .22f;
+		if (p >= 1.f)
+		{
+			setTheme(gPendingTheme);
+			gPendingTheme = -1;
+			gFadeAt = gTime;
+			gToast = std::string("Theme: ") + themeName(gThemeIndex);
+			gToastAt = gTime;
+			f = makeFrame();
+		}
+		else
+			fade = p;
+	}
+	else if (gTime - gFadeAt < .22f)
+		fade = 1.f - (gTime - gFadeAt) / .22f;
+
+	gTheme->draw(f);
+
+	if (fade > 0.f)
+		f.dl->AddRectFilled(ImVec2(0, 0), ImVec2(f.w, f.h), IM_COL32(0, 0, 0, (int)(255 * clamp01(fade))));
+	const float toastAge = gTime - gToastAt;
+	if (toastAge < 1.6f)
+	{
+		const float a = clamp01(std::fmin(toastAge / .15f, (1.6f - toastAge) / .3f));
+		const float fs = f.h * .03f, tw = textWidth(bodyFont(), fs, gToast);
+		const ImVec2 c(f.w / 2, f.h * .06f);
+		f.dl->AddRectFilled(ImVec2(c.x - tw / 2 - fs, c.y - fs * .2f), ImVec2(c.x + tw / 2 + fs, c.y + fs * 1.5f),
+				IM_COL32(10, 12, 18, (int)(200 * a)), fs * .4f);
+		drawText(f.dl, bodyFont(), fs, ImVec2(c.x, c.y + fs * .08f), IM_COL32(255, 255, 255, (int)(255 * a)), gToast, .5f);
+	}
+
+	// the start animation is over: boot the game (Flycast shows its loading screen)
+	if (gLaunchAt >= 0 && gTime - gLaunchAt >= gTheme->launchSeconds())
+	{
+		gLaunchAt = -1;
+		if (!gGames.empty())
+		{
+			const Game& g = gGames[gSel];
+			char line[600];
+			snprintf(line, sizeof(line), "launcher: starting %s", g.e.path.c_str());
+			ps4_boot_trace(line);
+			soundStop();
+			gui_ps4_start_game(g.e.path, g.e.title);
+		}
+	}
+	return true;
+}
