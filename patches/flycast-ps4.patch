@@ -0,0 +1,51 @@
+/*
+	DeCast-S4: box art from the libretro thumbnail server, matched by the disc's serial.
+
+	The serial (the IP.BIN product number Flycast's offline scraper reads, e.g. T13002N, MK-51117)
+	is looked up in libretro-database's Redump DAT for the Dreamcast, which gives the Redump name;
+	the thumbnail server names its box art after it. The DAT is downloaded once and kept with the
+	box art. Used on PS4 instead of TheGamesDB (core/ui/boxart/boxart.cpp).
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#pragma once
+#include "ui/boxart/scraper.h"
+
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+class LibretroScraper : public Scraper
+{
+public:
+	bool initialize(const std::string& saveDirectory) override;
+	// Throws std::runtime_error on network errors (the box-art thread retries those later).
+	void scrape(GameBoxart& item) override;
+
+private:
+	struct DatGame
+	{
+		std::string name;		// Redump name, e.g. "Sonic Adventure 2 (USA) (En,Ja,Fr,De,Es)"
+		std::string region;		// "USA", "Japan", "Europe", "USA, Europe", ...
+	};
+	bool loadDat();
+	bool parseDat(const std::string& text);
+	const DatGame *find(const std::string& serial, u32 region) const;
+
+	std::string directory;
+	std::unordered_map<std::string, std::vector<DatGame>> bySerial;	// normalized serial
+	u64 nextDatAttempt = 0;
+};
diff --git a/shell/ps4/launcher/sound.cpp b/shell/ps4/launcher/sound.cpp
new file mode 100644
index 000000000..dd665471f
--- /dev/null
+++ b/shell/ps4/launcher/sound.cpp
@@ -0,0 +1,193 @@
+/*
+	DeCast-S4 launcher sounds: short WAVs (48 kHz stereo 16-bit, /app0/launcher/sounds) mixed on
+	an audio-out port of their own while the home screen is up. The port closes when a game starts,
+	so the game's audio backend has the output to itself.
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "launcher_internal.h"
+#include "oslib/oslib.h"
+
+#include <orbis/AudioOut.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace launcher
+{
+namespace
+{
+constexpr int32_t kSystemUser = 0xFF;
+constexpr u32 kGrain = 256;
+constexpr int SOUND_COUNT = 6;
+constexpr int VOICES = 6;
+const char *const kNames[SOUND_COUNT] = { "move", "category", "confirm", "launch", "back", "error" };
+const float kGain[SOUND_COUNT] = { .45f, .55f, .6f, .7f, .5f, .55f };
+
+std::vector<s16> gClips[SOUND_COUNT];	// interleaved stereo
+bool gLoaded;
+
+struct Voice { int clip = -1; size_t pos = 0; };
+std::mutex gMutex;
+Voice gVoices[VOICES];
+
+std::atomic<bool> gRunning;
+std::thread gThread;
+int32_t gPort = -1;
+
+u32 le32(const u8 *p) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((u32)p[3] << 24); }
+u16 le16(const u8 *p) { return p[0] | (p[1] << 8); }
+
+// PCM 16-bit WAV, mono or stereo, into interleaved stereo
+bool loadWav(const std::string& path, std::vector<s16>& out)
+{
+	FILE *f = fopen(path.c_str(), "rb");
+	if (f == nullptr)
+		return false;
+	std::vector<u8> file;
+	u8 buf[8192];
+	size_t n;
+	while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+		file.insert(file.end(), buf, buf + n);
+	fclose(f);
+	if (file.size() < 12 || memcmp(&file[0], "RIFF", 4) || memcmp(&file[8], "WAVE", 4))
+		return false;
+	int channels = 0, bits = 0;
+	size_t p = 12;
+	while (p + 8 <= file.size())
+	{
+		const u32 size = le32(&file[p + 4]);
+		const size_t body = p + 8;
+		if (body + size > file.size())
+			break;
+		if (!memcmp(&file[p], "fmt ", 4) && size >= 16)
+		{
+			channels = le16(&file[body + 2]);
+			bits = le16(&file[body + 14]);
+		}
+		else if (!memcmp(&file[p], "data", 4) && bits == 16 && (channels == 1 || channels == 2))
+		{
+			const size_t frames = size / (2 * channels);
+			out.resize(frames * 2);
+			for (size_t i = 0; i < frames; i++)
+			{
+				const s16 l = (s16)le16(&file[body + i * 2 * channels]);
+				out[i * 2] = l;
+				out[i * 2 + 1] = channels == 2 ? (s16)le16(&file[body + i * 4 + 2]) : l;
+			}
+			return true;
+		}
+		p = body + size + (size & 1);
+	}
+	return false;
+}
+
+void outputLoop()
+{
+	ThreadName _("LauncherSound");
+	alignas(64) s16 out[kGrain * 2];
+	float mixBuf[kGrain * 2];
+	while (gRunning)
+	{
+		std::fill(std::begin(mixBuf), std::end(mixBuf), 0.f);
+		{
+			std::lock_guard<std::mutex> lock(gMutex);
+			for (Voice& v : gVoices)
+			{
+				if (v.clip < 0)
+					continue;
+				const std::vector<s16>& clip = gClips[v.clip];
+				const float gain = kGain[v.clip];
+				const size_t n = std::min<size_t>(kGrain * 2, clip.size() - v.pos);
+				for (size_t i = 0; i < n; i++)
+					mixBuf[i] += clip[v.pos + i] * gain;
+				v.pos += n;
+				if (v.pos >= clip.size())
+					v.clip = -1;
+			}
+		}
+		for (u32 i = 0; i < kGrain * 2; i++)
+			out[i] = (s16)std::clamp(mixBuf[i], -32768.f, 32767.f);
+		sceAudioOutOutput(gPort, out);	// blocks for one grain
+	}
+	sceAudioOutOutput(gPort, nullptr);	// wait for the last grain
+}
+} // namespace
+
+void soundStart()
+{
+	if (gRunning)
+		return;
+	if (!gLoaded)
+	{
+		gLoaded = true;
+		for (int i = 0; i < SOUND_COUNT; i++)
+			loadWav(std::string("/app0/launcher/sounds/") + kNames[i] + ".wav", gClips[i]);
+	}
+	const int32_t init = sceAudioOutInit();
+	if (init != 0 && init != (int32_t)0x8026000E)	// already initialized
+		return;
+	gPort = sceAudioOutOpen(kSystemUser, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, kGrain, 48000,
+			ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+	if (gPort < 0)
+		return;
+	int32_t volume[2] = { 32768, 32768 };
+	sceAudioOutSetVolume(gPort, 0x3, volume);
+	gRunning = true;
+	gThread = std::thread(outputLoop);
+}
+
+void soundStop()
+{
+	if (!gRunning)
+		return;
+	gRunning = false;
+	if (gThread.joinable())
+		gThread.join();
+	sceAudioOutClose(gPort);
+	gPort = -1;
+	std::lock_guard<std::mutex> lock(gMutex);
+	for (Voice& v : gVoices)
+		v.clip = -1;
+}
+
+void playSound(Sound s)
+{
+	const int clip = (int)s;
+	if (!gRunning || clip < 0 || clip >= SOUND_COUNT || gClips[clip].empty())
+		return;
+	std::lock_guard<std::mutex> lock(gMutex);
+	// a free voice, else the one closest to its end
+	Voice *best = &gVoices[0];
+	for (Voice& v : gVoices)
+	{
+		if (v.clip < 0) {
+			best = &v;
+			break;
+		}
+		if (v.pos > best->pos)
+			best = &v;
+	}
+	best->clip = clip;
+	best->pos = 0;
+}
+
+} // namespace launcher
diff --git a/shell/ps4/launcher/theme_channel.cpp b/shell/ps4/launcher/theme_channel.cpp
new file mode 100644
index 000000000..627a4ed56
--- /dev/null
+++ b/shell/ps4/launcher/theme_channel.cpp
@@ -0,0 +1,326 @@
+/*
+	DeCast-S4 launcher, theme "Channel": every game is a TV channel. The cover fills the screen
+	like a broadcast with a slow camera drift (a synthwave scene in the game's colours when there
+	is no cover); changing channel rolls the picture through static. Starting a game switches the
+	set off.
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "launcher_internal.h"
+
+#include <algorithm>
+#include <ctime>
+
+namespace launcher
+{
+namespace
+{
+
+class Channel : public Theme
+{
+public:
+	const char *name() const override { return "Channel"; }
+	float launchSeconds() const override { return 1.1f; }
+
+	void draw(Frame& f) override
+	{
+		std::vector<Game>& games = *f.games;
+		const int n = (int)games.size();
+		ImDrawList *dl = f.dl;
+		dl->AddRectFilled(ImVec2(0, 0), ImVec2(f.w, f.h), IM_COL32(0, 0, 0, 255));
+		if (n == 0)
+		{
+			drawStatic(f, .35f);
+			drawEmptyLibrary(f);
+			drawHints(f);
+			return;
+		}
+		if (!started)
+		{
+			started = true;
+			guidePos = (float)f.goal;
+		}
+		spring(guidePos, guideVel, (float)f.goal, 120.f, 22.f, f.dt);
+		const Game& g = games[f.sel];
+		const float age = f.t - f.selectedAt;
+		const float launch = f.launchAt >= 0 ? clamp01((f.t - f.launchAt) / launchSeconds()) : 0.f;
+
+		if (launch > 0)
+		{
+			drawPowerOff(f, g, launch);
+			return;
+		}
+
+		// the picture rolls down into place after a change
+		const float roll = age < .5f ? (1 - easeOut(age / .5f)) * f.h * .35f : 0.f;
+		drawPicture(f, g, ImVec4(0, roll, f.w, f.h + roll), 1.f, 0.f);
+		if (roll > 0)
+		{
+			drawPicture(f, g, ImVec4(0, roll - f.h, f.w, roll), 1.f, 0.f);
+			// the blanking bar between frames
+			dl->AddRectFilled(ImVec2(0, roll - f.h * .03f), ImVec2(f.w, roll + f.h * .015f), IM_COL32(0, 0, 0, 230));
+		}
+		// static: a burst on change, a whisper otherwise
+		drawStatic(f, std::max(.035f, 1.f - age / .32f));
+
+		drawLowerThird(f, g, age);
+		drawGuide(f);
+		drawChannelNumber(f, age);
+		drawTube(f);
+		drawHints(f);
+	}
+
+private:
+	// The broadcast: the cover with a slow drift, or a synthwave scene in the game's colours
+	void drawPicture(Frame& f, const Game& g, ImVec4 r, float alpha, float whiten)
+	{
+		ImDrawList *dl = f.dl;
+		const ImTextureID tex = coverTexture(g);
+		const float phase = (float)(std::hash<std::string>()(g.e.path) % 1000) * .01f;
+		if (tex != ImTextureID())
+		{
+			const float zoom = 1.18f + .07f * std::sin(f.t * .09f + phase);
+			const float aspect = (r.w - r.y) / (r.z - r.x);		// screen height / width
+			const float uw = 1.f / zoom, uh = aspect / zoom;
+			const float cu = .5f + (.5f - uw * .5f) * std::sin(f.t * .061f + phase);
+			const float cv = .5f + (.5f - uh * .5f) * .8f * std::cos(f.t * .047f + phase * 1.3f);
+			dl->AddImage(tex, ImVec2(r.x, r.y), ImVec2(r.z, r.w), ImVec2(cu - uw / 2, cv - uh / 2), ImVec2(cu + uw / 2, cv + uh / 2),
+					IM_COL32(255, 255, 255, (int)(255 * alpha)));
+			// the set's colour: a wash of the game's dark tone
+			dl->AddRectFilled(ImVec2(r.x, r.y), ImVec2(r.z, r.w), g.c2.u32(.28f * alpha * (1 - whiten)));
+		}
+		else
+			drawSynthwave(f, g, r, alpha);
+		if (whiten > 0)
+			dl->AddRectFilled(ImVec2(r.x, r.y), ImVec2(r.z, r.w), IM_COL32(255, 255, 255, (int)(255 * whiten * alpha)));
+	}
+
+	void drawSynthwave(Frame& f, const Game& g, ImVec4 r, float alpha)
+	{
+		ImDrawList *dl = f.dl;
+		const float w = r.z - r.x, h = r.w - r.y;
+		const float horizon = r.y + h * .58f;
+		const Color sky1 = mix(g.c2, { 0, 0, 0 }, .3f), sky2 = mix(g.c1, { 1, .2f, .6f }, .35f);
+		dl->AddRectFilledMultiColor(ImVec2(r.x, r.y), ImVec2(r.z, horizon), sky1.u32(alpha), sky1.u32(alpha), sky2.u32(alpha), sky2.u32(alpha));
+		// the sun, cut by bars that thicken toward the horizon
+		const ImVec2 sun(r.x + w * .5f, horizon - h * .14f);
+		const float sr = h * .2f;
+		dl->AddCircleFilled(sun, sr, mix(g.c1, { 1, .9f, .4f }, .5f).u32(alpha), 64);
+		for (int i = 0; i < 7; i++)
+		{
+			const float y = sun.y + sr * (.05f + i * .14f) + std::fmod(f.t * 6.f, sr * .14f);
+			const float th = 1.5f + i * 1.6f;
+			if (y > horizon)
+				break;
+			const Color c = mix(sky1, sky2, clamp01((y - r.y) / (horizon - r.y)));
+			dl->AddRectFilled(ImVec2(sun.x - sr - 2, y), ImVec2(sun.x + sr + 2, std::min(horizon, y + th)), c.u32(alpha));
+		}
+		// mountains
+		ImVec2 ridge[24];
+		for (int i = 0; i < 24; i++)
+		{
+			const float x = (float)i / 23;
+			const float m = .5f + .5f * std::sin(x * 13.f + 1.7f) * std::sin(x * 5.3f + .3f);
+			ridge[i] = ImVec2(r.x + x * w, horizon - h * .03f - m * h * .09f * (std::fabs(x - .5f) * 1.6f + .2f));
+		}
+		for (int i = 0; i < 23; i++)
+		{
+			const ImVec2 q[4] = { ridge[i], ridge[i + 1], ImVec2(ridge[i + 1].x, horizon), ImVec2(ridge[i].x, horizon) };
+			const ImVec2 uv[4] {};
+			const ImU32 c[4] = { IM_COL32(10, 4, 24, (int)(255 * alpha)), IM_COL32(10, 4, 24, (int)(255 * alpha)),
+				IM_COL32(20, 8, 40, (int)(255 * alpha)), IM_COL32(20, 8, 40, (int)(255 * alpha)) };
+			drawQuad(dl, ImTextureID(), q, uv, c);
+		}
+		// the grid running toward us
+		dl->AddRectFilledMultiColor(ImVec2(r.x, horizon), ImVec2(r.z, r.w), IM_COL32(12, 2, 30, (int)(255 * alpha)),
+				IM_COL32(12, 2, 30, (int)(255 * alpha)), IM_COL32(2, 0, 8, (int)(255 * alpha)), IM_COL32(2, 0, 8, (int)(255 * alpha)));
+		const ImU32 line = mix(g.c1, { 1, .3f, .9f }, .4f).u32(.8f * alpha);
+		for (int i = -14; i <= 14; i++)
+			dl->AddLine(ImVec2(r.x + w * .5f + i * w * .012f, horizon), ImVec2(r.x + w * .5f + i * w * .16f, r.w), line, 1.5f);
+		for (int i = 0; i < 14; i++)
+		{
+			const float z = std::fmod(i / 14.f + f.t * .12f, 1.f);
+			const float y = horizon + (r.w - horizon) * z * z;
+			dl->AddLine(ImVec2(r.x, y), ImVec2(r.z, y), mix(g.c1, { 1, .3f, .9f }, .4f).u32(alpha * (.2f + .8f * z)), 1.f + z * 1.5f);
+		}
+		drawBlob(dl, ImVec2(r.x + w * .5f, horizon), w * .3f, mix(g.c1, { 1, .3f, .9f }, .4f).u32(.35f * alpha));
+	}
+
+	void drawStatic(Frame& f, float amount)
+	{
+		const ImTextureID tex = noiseTexture();
+		if (tex == ImTextureID() || amount <= 0)
+			return;
+		// a new pattern every frame: jump around the texture (and flip it) by frame count
+		frame++;
+		// (the sampler clamps: stay inside 0..1)
+		const float u = ((frame * 0.618034f) - std::floor(frame * 0.618034f)) * .4f;
+		const float v = ((frame * 0.414214f) - std::floor(frame * 0.414214f)) * .45f;
+		const bool flip = frame & 1;
+		f.dl->AddImage(tex, ImVec2(0, 0), ImVec2(f.w, f.h), ImVec2(flip ? u + .6f : u, v), ImVec2(flip ? u : u + .6f, v + .55f),
+				IM_COL32(255, 255, 255, (int)(255 * clamp01(amount))));
+	}
+
+	void drawLowerThird(Frame& f, const Game& g, float age)
+	{
+		ImDrawList *dl = f.dl;
+		const float in = easeOut((age - .18f) / .45f);
+		const float top = f.h * .66f, bottom = f.h * .88f;
+		dl->AddRectFilledMultiColor(ImVec2(0, top - f.h * .08f), ImVec2(f.w, f.h), IM_COL32(0, 0, 0, 0), IM_COL32(0, 0, 0, 0),
+				IM_COL32(0, 0, 0, 235), IM_COL32(0, 0, 0, 235));
+		const float slide = (1 - in) * -f.w * .08f;
+		const float x = f.w * .06f + slide;
+		// "now playing" card
+		const float card = bottom - top;
+		const ImTextureID tex = coverTexture(g);
+		const ImVec2 c0(x, top), c1(x + card, bottom);
+		dl->AddRectFilled(ImVec2(c0.x + 6, c0.y + 8), ImVec2(c1.x + 6, c1.y + 8), IM_COL32(0, 0, 0, (int)(140 * in)), 6.f);
+		if (tex != ImTextureID())
+			dl->AddImageRounded(tex, c0, c1, ImVec2(0, 0), ImVec2(1, 1), IM_COL32(255, 255, 255, (int)(255 * in)), 6.f);
+		else
+			dl->AddRectFilledMultiColor(c0, c1, g.c1.u32(in), g.c2.u32(in), g.c2.u32(in), g.c1.u32(in));
+		dl->AddRect(c0, c1, IM_COL32(255, 255, 255, (int)(90 * in)), 6.f, 0, 1.5f);
+
+		const float tx = c1.x + f.w * .025f;
+		// LIVE tag and an accent bar in the game's colour
+		dl->AddRectFilled(ImVec2(tx, top), ImVec2(tx + f.h * .075f, top + f.h * .03f), IM_COL32(220, 30, 40, (int)(255 * in)), 3.f);
+		drawText(dl, displayFont(), f.h * .017f, ImVec2(tx + f.h * .0375f, top + f.h * .006f), IM_COL32(255, 255, 255, (int)(255 * in)), "LIVE", .5f);
+		const float blink = .5f + .5f * std::sin(f.t * 5.f);
+		dl->AddCircleFilled(ImVec2(tx + f.h * .09f, top + f.h * .015f), f.h * .006f, IM_COL32(255, 60, 60, (int)(255 * in * blink)));
+		const float titleSize = f.h * .055f;
+		// RGB split that settles after the change
+		const float split = (1 - easeOut(age / .6f)) * f.h * .008f + 1.2f;
+		const float maxW = f.w * .94f - tx;
+		const ImVec2 tp(tx, top + f.h * .045f);
+		drawText(dl, displayFont(), titleSize, ImVec2(tp.x - split, tp.y), IM_COL32(255, 40, 60, (int)(150 * in)), g.e.title, 0, maxW);
+		drawText(dl, displayFont(), titleSize, ImVec2(tp.x + split, tp.y), IM_COL32(40, 200, 255, (int)(150 * in)), g.e.title, 0, maxW);
+		drawText(dl, displayFont(), titleSize, tp, IM_COL32(255, 255, 255, (int)(255 * in)), g.e.title, 0, maxW);
+		std::string info = g.format;
+		if (!g.regionName.empty())
+			info += "   \xC2\xB7   " + g.regionName;
+		if (!g.e.productId.empty())
+			info += "   \xC2\xB7   " + g.e.productId;
+		drawText(dl, bodyFont(), f.h * .026f, ImVec2(tx, top + f.h * .125f), mix(g.c1, { 1, 1, 1 }, .5f).u32(in), info);
+		// the accent line, drawn across
+		const float lineW = (f.w * .94f - tx) * easeOut((age - .3f) / .6f);
+		dl->AddRectFilled(ImVec2(tx, bottom - 3), ImVec2(tx + lineW, bottom), g.c1.u32(in));
+	}
+
+	// The channel guide: neighbouring channels at the top, riding a spring
+	void drawGuide(Frame& f)
+	{
+		std::vector<Game>& games = *f.games;
+		const int n = (int)games.size();
+		ImDrawList *dl = f.dl;
+		const float y = f.h * .05f, hgt = f.h * .1f, step = hgt * 1.25f;
+		const float cx = f.w * .5f;
+		dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(f.w, y + hgt * 1.6f), IM_COL32(0, 0, 0, 200), IM_COL32(0, 0, 0, 200),
+				IM_COL32(0, 0, 0, 0), IM_COL32(0, 0, 0, 0));
+		const int span = std::min(5, n - 1);
+		for (int i = (int)std::floor(guidePos) - span - 1; i <= (int)std::ceil(guidePos) + span + 1; i++)
+		{
+			const float k = i - guidePos;
+			if (std::fabs(k) > span + .5f && n > 1)
+				continue;
+			if (n == 1 && i != f.goal)
+				continue;
+			const int idx = ((i % n) + n) % n;
+			const float near = clamp01(1 - std::fabs(k));
+			const float s = hgt * (.72f + .28f * near);
+			const float x = cx + k * step;
+			const float a = clamp01(1.2f - std::fabs(k) / (span + .5f)) * (.45f + .55f * near);
+			const ImVec2 p0(x - s / 2, y + (hgt - s) / 2), p1(x + s / 2, y + (hgt + s) / 2);
+			const ImTextureID tex = coverTexture(games[idx]);
+			if (tex != ImTextureID())
+				dl->AddImageRounded(tex, p0, p1, ImVec2(0, 0), ImVec2(1, 1), IM_COL32(255, 255, 255, (int)(255 * a)), 4.f);
+			else
+				dl->AddRectFilledMultiColor(p0, p1, games[idx].c1.u32(a), games[idx].c2.u32(a), games[idx].c2.u32(a), games[idx].c1.u32(a));
+			if (near > .01f)
+				dl->AddRect(ImVec2(p0.x - 3, p0.y - 3), ImVec2(p1.x + 3, p1.y + 3), IM_COL32(255, 255, 255, (int)(230 * near)), 6.f, 0, 2.f);
+			char num[8];
+			snprintf(num, sizeof(num), "%02d", idx + 1);
+			drawText(dl, displayFont(), f.h * .016f, ImVec2(x, p1.y + f.h * .008f), IM_COL32(255, 255, 255, (int)(200 * a)), num, .5f);
+		}
+	}
+
+	void drawChannelNumber(Frame& f, float age)
+	{
+		char text[16];
+		snprintf(text, sizeof(text), "CH %02d", f.sel + 1);
+		const float size = f.h * .07f;
+		const ImVec2 p(f.w * .94f, f.h * .2f);
+		// on screen for a while after a change, like a real set; then faint
+		const float a = age < 2.5f ? 1.f : std::max(.25f, 1.f - (age - 2.5f) / .6f);
+		const float jitter = age < .3f ? (std::sin(f.t * 90.f) * f.h * .004f) : 0.f;
+		drawText(f.dl, displayFont(), size, ImVec2(p.x - 3 + jitter, p.y), IM_COL32(255, 0, 60, (int)(120 * a)), text, 1.f);
+		drawText(f.dl, displayFont(), size, ImVec2(p.x + 3 + jitter, p.y), IM_COL32(0, 220, 255, (int)(120 * a)), text, 1.f);
+		drawText(f.dl, displayFont(), size, ImVec2(p.x + jitter, p.y), IM_COL32(120, 255, 140, (int)(235 * a)), text, 1.f);
+	}
+
+	// Scanlines and the curved tube's dark corners
+	void drawTube(Frame& f)
+	{
+		ImDrawList *dl = f.dl;
+		for (float y = 0; y < f.h; y += 4.f)
+			dl->AddRectFilled(ImVec2(0, y), ImVec2(f.w, y + 1.5f), IM_COL32(0, 0, 0, 46));
+		// a bright band drifting down the tube
+		const float band = std::fmod(f.t * .12f, 1.3f) * f.h - f.h * .15f;
+		dl->AddRectFilledMultiColor(ImVec2(0, band), ImVec2(f.w, band + f.h * .12f), IM_COL32(255, 255, 255, 0), IM_COL32(255, 255, 255, 0),
+				IM_COL32(255, 255, 255, 10), IM_COL32(255, 255, 255, 10));
+		const float e = f.h * .22f;
+		const ImU32 dark = IM_COL32(0, 0, 0, 170), clear = IM_COL32(0, 0, 0, 0);
+		dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(e, f.h), dark, clear, clear, dark);
+		dl->AddRectFilledMultiColor(ImVec2(f.w - e, 0), ImVec2(f.w, f.h), clear, dark, dark, clear);
+		dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(f.w, e * .6f), dark, dark, clear, clear);
+		dl->AddRectFilledMultiColor(ImVec2(0, f.h - e * .5f), ImVec2(f.w, f.h), clear, clear, dark, dark);
+	}
+
+	// The set switching off: the picture folds into a bright line, the line into a dot, the dot fades
+	void drawPowerOff(Frame& f, const Game& g, float p)
+	{
+		const ImVec2 c(f.w / 2, f.h / 2);
+		if (p < .45f)
+		{
+			const float q = easeOut(p / .45f);
+			const float hh = std::max(2.f, f.h / 2 * (1 - q));
+			drawPicture(f, g, ImVec4(0, c.y - hh, f.w, c.y + hh), 1.f, q);
+		}
+		else if (p < .75f)
+		{
+			const float q = easeOut((p - .45f) / .3f);
+			const float hw = std::max(3.f, f.w / 2 * (1 - q));
+			f.dl->AddRectFilled(ImVec2(c.x - hw, c.y - 2), ImVec2(c.x + hw, c.y + 2), IM_COL32(255, 255, 255, 255));
+			drawBlob(f.dl, c, hw * .6f + 20, IM_COL32(200, 220, 255, 90));
+		}
+		else
+		{
+			const float q = (p - .75f) / .25f;
+			drawBlob(f.dl, c, 26.f * (1 - q) + 4, IM_COL32(255, 255, 255, (int)(255 * (1 - q))));
+		}
+	}
+
+	bool started = false;
+	float guidePos = 0, guideVel = 0;
+	u32 frame = 0;
+};
