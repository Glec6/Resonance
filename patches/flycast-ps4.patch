+/*
+	DeCast-S4: audio through sceAudioOut.
+
+	The AICA's 44.1 kHz stereo goes into a ring buffer; an output thread resamples it to the
+	48 kHz the PS4's audio out plays and hands it over one 256-frame grain at a time
+	(sceAudioOutOutput blocks until the previous grain plays, which paces the thread).
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "audio/audiostream.h"
+#include "cfg/option.h"
+#include "oslib/oslib.h"
+#include "stdclass.h"
+
+#include <orbis/AudioOut.h>
+#include <orbis/libkernel.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace
+{
+constexpr int32_t kSystemUser = 0xFF;		// the main port, whoever is signed in
+constexpr u32 kGrainFrames = 256;
+constexpr u32 kOutputRate = 48000;
+constexpr u32 kInputRate = 44100;
+constexpr int32_t kVolumeMax = 32768;		// SCE_AUDIO_VOLUME_0DB
+// libkernel declares these without parameters
+using SetAffinityFn = int32_t (*)(OrbisPthread, uint64_t);
+using SetPrioFn = int32_t (*)(OrbisPthread, int);
+}
+
+class PS4AudioBackend : public AudioBackend
+{
+public:
+	PS4AudioBackend()
+		: AudioBackend("ps4", "PS4 Audio Out") {}
+
+	bool init() override
+	{
+		const int32_t result = sceAudioOutInit();
+		// already initialized by an earlier backend instance is fine
+		if (result != 0 && result != (int32_t)0x8026000E)
+		{
+			ERROR_LOG(AUDIO, "PS4: sceAudioOutInit failed: %x", result);
+			return false;
+		}
+		port = sceAudioOutOpen(kSystemUser, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, kGrainFrames, kOutputRate,
+				ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+		if (port < 0)
+		{
+			ERROR_LOG(AUDIO, "PS4: sceAudioOutOpen failed: %x", port);
+			return false;
+		}
+		int32_t volume[2] = { kVolumeMax, kVolumeMax };
+		sceAudioOutSetVolume(port, 0x3, volume);	// front left + right
+
+		capacity = std::max<u32>(SAMPLE_COUNT * 2, (u32)config::AudioBufferSize);
+		ring.assign(capacity, 0);
+		readPos = 0;
+		count = 0;
+		position = 0.0;
+		underruns = 0;
+		running = true;
+		thread = std::thread(&PS4AudioBackend::outputLoop, this);
+		INFO_LOG(AUDIO, "PS4: audio port %x, buffer %u frames", port, capacity);
+		return true;
+	}
+
+	u32 push(const void *data, u32 frames, bool wait) override
+	{
+		const u32 *in = (const u32 *)data;
+		std::unique_lock<std::mutex> lock(mutex);
+		// timed: a signal can make a PS4 condition variable lose its wakeup (DolphinPS4)
+		if (wait)
+			while (!spaceFreed.wait_for(lock, std::chrono::milliseconds(20),
+					[&] { return count + frames <= capacity || !running; }))
+				;
+		const u32 n = std::min(frames, capacity - count);
+		u32 writePos = (readPos + count) % capacity;
+		for (u32 i = 0; i < n; i++)
+		{
+			ring[writePos] = in[i];
+			writePos = writePos + 1 == capacity ? 0 : writePos + 1;
+		}
+		count += n;
+		return 1;
+	}
+
+	void term() override
+	{
+		if (!running)
+			return;
+		{
+			std::lock_guard<std::mutex> lock(mutex);
+			running = false;
+		}
+		spaceFreed.notify_all();
+		if (thread.joinable())
+			thread.join();
+		if (port >= 0)
+		{
+			sceAudioOutClose(port);
+			port = -1;
+		}
+	}
+
+private:
+	static s16 left(u32 frame) { return (s16)(frame & 0xffff); }
+	static s16 right(u32 frame) { return (s16)(frame >> 16); }
+
+	void outputLoop()
+	{
+		ThreadName _("PS4AudioOut");
+		// a thread inherits its creator's cores; take all of the app's, and a priority above the
+		// emulation's so a slow frame doesn't make the sound crackle
+		const OrbisPthread self = scePthreadSelf();
+		((SetAffinityFn)&scePthreadSetaffinity)(self, 0x3F);
+		((SetPrioFn)&scePthreadSetprio)(self, 400);
+
+		alignas(32) s16 grains[2][kGrainFrames * 2];
+		int current = 0;
+		const double step = (double)kInputRate / kOutputRate;
+		while (running)
+		{
+			s16 *out = grains[current];
+			bool filled = false;
+			{
+				std::lock_guard<std::mutex> lock(mutex);
+				// input frames this grain reads (plus one to interpolate towards)
+				const u32 needed = (u32)(position + step * kGrainFrames) + 2;
+				if (count >= needed)
+				{
+					double pos = position;
+					for (u32 i = 0; i < kGrainFrames; i++)
+					{
+						const u32 index = (u32)pos;
+						const float frac = (float)(pos - index);
+						const u32 a = ring[(readPos + index) % capacity];
+						const u32 b = ring[(readPos + index + 1) % capacity];
+						out[i * 2] = (s16)(left(a) + (left(b) - left(a)) * frac);
+						out[i * 2 + 1] = (s16)(right(a) + (right(b) - right(a)) * frac);
+						pos += step;
+					}
+					const u32 consumed = (u32)pos;
+					position = pos - consumed;
+					readPos = (readPos + consumed) % capacity;
+					count -= consumed;
+					filled = true;
+				}
+			}
+			if (filled)
+				spaceFreed.notify_all();
+			else
+			{
+				// the emulator is behind (a slow frame, the menu, loading): silence
+				std::fill(out, out + kGrainFrames * 2, 0);
+				underruns++;
+			}
+			sceAudioOutOutput(port, out);
+			current ^= 1;
+		}
+		sceAudioOutOutput(port, nullptr);	// wait for the last grain
+	}
+
+	int32_t port = -1;
+	std::vector<u32> ring;
+	u32 capacity = 0;
+	u32 readPos = 0;
+	u32 count = 0;
+	double position = 0.0;		// fractional read position (input frames)
+	u64 underruns = 0;
+	std::atomic<bool> running { false };
+	std::mutex mutex;
+	std::condition_variable spaceFreed;
+	std::thread thread;
+};
+static PS4AudioBackend ps4AudioBackend;
