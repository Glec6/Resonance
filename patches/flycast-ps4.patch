+# DeCast-S4: Flycast on PS4 homebrew. Built with the DeCast-S4 toolchain (toolchain/ps4-decast.cmake,
+# ps4-love-style.cmake: PS4_RUNTIME_SOURCES, ps4_link_mesa, ps4_add_eboot).
+target_sources(${PROJECT_NAME} PRIVATE
+	ps4_main.cpp
+	ps4_stubs.c
+	ps4_gamepad.cpp
+	ps4_gamepad.h
+	ps4_vmem.cpp
+	ps4_wsi.cpp
+	ps4_wsi.h
+	audiobackend_ps4.cpp
+	launcher/launcher.cpp
+	launcher/launcher.h
+	launcher/launcher_internal.h
+	launcher/covers.cpp
+	launcher/libretro_scraper.h
+	launcher/sound.cpp
+	launcher/theme_orbit.cpp
+	launcher/theme_channel.cpp
+	launcher/theme_shelf.cpp
+	launcher/theme_xmb.cpp
+	${PS4_RUNTIME_SOURCES})
+target_include_directories(${PROJECT_NAME} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
+# FreeBSD kernel without sockets for local IPC or serial ports
+target_compile_definitions(${PROJECT_NAME} PRIVATE
+	ASIO_DISABLE_LOCAL_SOCKETS
+	ASIO_DISABLE_SERIAL_PORT
+	ASIO_DISABLE_KQUEUE)
+
+# curl + OpenSSL from the sysroot (Crema's PSChrome recipes) for box art and achievements
+target_compile_definitions(${PROJECT_NAME} PRIVATE CURL_STATICLIB)
+target_link_libraries(${PROJECT_NAME} PRIVATE
+	${PS4_SYSROOT}/lib/libcurl.a ${PS4_SYSROOT}/lib/libssl.a ${PS4_SYSROOT}/lib/libcrypto.a)
+
+# RADV on GNM, the system libraries, and eboot.bin
+ps4_link_mesa(${PROJECT_NAME})
+target_link_libraries(${PROJECT_NAME} PRIVATE
+	SceSysmodule SceSystemService SceUserService SceVideoOut SceAudioOut ScePad SceNet)
+ps4_add_eboot(${PROJECT_NAME})
