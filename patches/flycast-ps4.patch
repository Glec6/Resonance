+/*
+	DeCast-S4: the PS4 home screen (launcher) that replaces Flycast's game list.
+
+	Four themes share one library, cover and input layer: Orbit (discs on a ring), Channel (a TV
+	set), Shelf (box art in 3D) and Cross bar. Square cycles them; the choice is saved.
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#pragma once
+#include "types.h"
+#include <string>
+#include <vector>
+
+// One game in the library, as the GUI's scanner and box-art database know it (ui/gui.cpp).
+struct LauncherEntry
+{
+	std::string path;		// what gui_start_game() takes
+	std::string fileName;	// last path component
+	std::string title;		// from the disc header, else the file name
+	std::string productId;	// e.g. T13002N, MK-51117 (empty until the disc has been read)
+	u32 region = 0;			// GameBoxart::Region bits
+	std::string coverPath;	// box art on disk, if any
+};
+
+// ui/gui.cpp, PS4 only
+void gui_ps4_list_games(std::vector<LauncherEntry>& out);
+void gui_ps4_start_game(const std::string& path, const std::string& title);
+void gui_ps4_open_settings();
+
+// Called before ImGui::NewFrame (fonts can only be added between frames).
+void launcher_pre_frame();
+// Draws the home screen for this frame; false when it can't (then Flycast's list is shown).
+bool launcher_draw();
diff --git a/shell/ps4/launcher/launcher_internal.h b/shell/ps4/launcher/launcher_internal.h
new file mode 100644
index 000000000..5b633160a
--- /dev/null
+++ b/shell/ps4/launcher/launcher_internal.h
@@ -0,0 +1,136 @@
+/*
+	DeCast-S4 launcher internals: what the core (launcher.cpp) shares with the themes
+	(theme_*.cpp), covers (covers.cpp) and sounds (sound.cpp).
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#pragma once
+#include "launcher.h"
+#include "imgui.h"
+
+#include <cmath>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace launcher
+{
+
+constexpr float PI = 3.14159265f;
+
+struct Color
+{
+	float r = 0, g = 0, b = 0;
+	ImU32 u32(float a = 1.f) const {
+		auto c = [](float v) { return (int)std::lround(std::fmin(1.f, std::fmax(0.f, v)) * 255.f); };
+		return IM_COL32(c(r), c(g), c(b), c(a));
+	}
+};
+Color mix(const Color& a, const Color& b, float t);
+Color hsv(float h, float s, float v);
+// Moves a colour toward a target at a rate (frame-rate independent)
+void approach(Color& c, const Color& target, float rate, float dt);
+
+struct Game
+{
+	LauncherEntry e;
+	std::string cover;		// cover image to show (user's, downloaded, from the disc), or empty
+	std::string format;		// GDI, CHD, CDI
+	std::string regionName;	// USA, Japan, Europe
+	Color c1, c2;			// bright and dark colour of the game (from its cover once read)
+	bool paletteFromCover = false;
+};
+
+// Everything a theme needs for one frame.
+struct Frame
+{
+	ImDrawList *dl;
+	float w, h;				// screen size
+	float t, dt;			// seconds since the launcher started, frame time
+	std::vector<Game> *games;
+	int sel;				// selected game
+	int goal;				// selection without wrapping (themes ride springs toward it)
+	float selectedAt;		// when the selection last changed
+	float launchAt;			// when Start was pressed, or < 0
+};
+
+class Theme
+{
+public:
+	virtual ~Theme() = default;
+	virtual const char *name() const = 0;
+	virtual void draw(Frame& f) = 0;
+	// Seconds the start animation takes before the game is booted.
+	virtual float launchSeconds() const { return 1.4f; }
+	// Directional input: true when the theme used it (the Cross bar has two axes).
+	virtual bool navigate(Frame& f, int dx, int dy) { return false; }
+	// Cross: true when the theme handled it itself (Cross bar menus other than Games).
+	virtual bool activate(Frame& f) { return false; }
+};
+std::unique_ptr<Theme> makeOrbit();
+std::unique_ptr<Theme> makeChannel();
+std::unique_ptr<Theme> makeShelf();
+std::unique_ptr<Theme> makeCrossBar();
+constexpr int THEME_COUNT = 4;
+const char *themeName(int index);
+
+// Requests from themes to the core
+void requestTheme(int index);
+int currentTheme();
+void openSettings();
+void moveSelection(int delta);
+
+// Drawing helpers (launcher.cpp)
+ImFont *displayFont();	// Michroma
+ImFont *bodyFont();		// Flycast's UI font (Roboto, with Font Awesome icons)
+ImTextureID coverTexture(const Game& g);	// 0 while loading or without a cover
+ImTextureID blobTexture();		// soft round light, white
+ImTextureID discTexture();		// silver disc surface
+ImTextureID noiseTexture();		// TV static
+ImVec2 whiteUV(ImDrawList *dl);
+void drawBlob(ImDrawList *dl, ImVec2 c, float r, ImU32 col);
+// Text: align 0 = left, .5 = centre, 1 = right; clipped with an ellipsis at maxWidth (0 = none)
+float drawText(ImDrawList *dl, ImFont *font, float size, ImVec2 pos, ImU32 col, const std::string& text,
+		float align = 0.f, float maxWidth = 0.f);
+float textWidth(ImFont *font, float size, const std::string& text);
+// The PS button symbols: 'x' cross, 'o' circle, 's' square, 't' triangle
+void drawButton(ImDrawList *dl, char which, ImVec2 c, float size, float alpha = 1.f);
+// The control hints along the bottom of the screen
+void drawHints(Frame& f, float alpha = 1.f);
+// A textured (or plain, tex = 0) quad with per-corner uv and colour: p0..p3 clockwise from top left
+void drawQuad(ImDrawList *dl, ImTextureID tex, const ImVec2 p[4], const ImVec2 uv[4], const ImU32 col[4]);
+// Library empty: the message in the middle of the screen
+void drawEmptyLibrary(Frame& f);
+float easeOut(float t);
+float clamp01(float t);
+// Spring toward goal (critically damped-ish); returns the new position
+void spring(float& pos, float& vel, float goal, float stiffness, float damping, float dt);
+bool reducedMotion();
+
+// covers.cpp
+// The cover to show for a game: the user's own file in /data/DeCast-S4/covers wins, else the
+// box-art database's (downloaded from libretro, or the disc's own 0GDTEX image).
+std::string userCover(const LauncherEntry& e);
+// Bright/dark colours from a cover image (false when it can't be read)
+bool paletteFromImage(const std::string& path, Color& c1, Color& c2);
+
+// sound.cpp
+enum class Sound { Move, Category, Confirm, Launch, Back, Error };
+void soundStart();
+void soundStop();
+void playSound(Sound s);
+
+} // namespace launcher
