+#include <stdexcept>
+#include <unordered_map>
+
+extern "C" void ps4_boot_trace(const char *line);
+
+namespace
+{
+const char *const kUserCovers = "/data/DeCast-S4/covers/";
+const char *const kDatUrl = "https://raw.githubusercontent.com/libretro/libretro-database/master/metadat/redump/Sega%20-%20Dreamcast.dat";
+const char *const kThumbUrl = "https://thumbnails.libretro.com/Sega%20-%20Dreamcast/Named_Boxarts/";
+const char *const kDatFile = "libretro-dreamcast.dat";
+
+// Letters and digits only, upper case: "T-13002N" and "T13002N" are the same disc
+std::string normalizeSerial(const std::string& s)
+{
+	std::string out;
+	for (char c : s)
+		if (isalnum((unsigned char)c))
+			out += (char)toupper((unsigned char)c);
+	return out;
+}
+
+// The thumbnail server's file names: these characters become '_'
+std::string thumbnailName(std::string name)
+{
+	for (char& c : name)
+		if (strchr("&*/:`<>?\\|\"", c) != nullptr)
+			c = '_';
+	return name;
+}
+
+// Percent-encode what a URL path can't hold; the server wants ( ) , ' ! as they are
+std::string encodePath(const std::string& s)
+{
+	static const char hex[] = "0123456789ABCDEF";
+	std::string out;
+	for (char ch : s)
+	{
+		const unsigned char c = (unsigned char)ch;
+		if (isalnum(c) || strchr("-_.~()!,'+;=@", c) != nullptr)
+			out += ch;
+		else
+		{
+			out += '%';
+			out += hex[c >> 4];
+			out += hex[c & 15];
+		}
+	}
+	return out;
+}
+
+bool readFile(const std::string& path, std::string& out)
+{
+	FILE *f = nowide::fopen(path.c_str(), "rb");
+	if (f == nullptr)
+		return false;
+	char buf[16384];
+	size_t n;
+	out.clear();
+	while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+		out.append(buf, n);
+	fclose(f);
+	return true;
+}
+
+// The quoted value after a key on a DAT line: `	serial "T-13002N"`
+bool datValue(const std::string& line, const char *key, std::string& value)
+{
+	size_t p = line.find_first_not_of(" \t");
+	const size_t keyLen = strlen(key);
+	if (p == std::string::npos || line.compare(p, keyLen, key) != 0 || line.size() <= p + keyLen
+			|| (line[p + keyLen] != ' ' && line[p + keyLen] != '\t'))
+		return false;
+	const size_t q1 = line.find('"', p + keyLen);
+	const size_t q2 = q1 == std::string::npos ? q1 : line.find('"', q1 + 1);
+	if (q2 == std::string::npos)
+		return false;
+	value = line.substr(q1 + 1, q2 - q1 - 1);
+	return true;
+}
+
+bool regionMatches(const std::string& datRegion, u32 region)
+{
+	return ((region & GameBoxart::USA) && datRegion.find("USA") != std::string::npos)
+		|| ((region & GameBoxart::JAPAN) && datRegion.find("Japan") != std::string::npos)
+		|| ((region & GameBoxart::EUROPE) && datRegion.find("Europe") != std::string::npos);
+}
+}
+
+// ---- LibretroScraper ----
+
+bool LibretroScraper::initialize(const std::string& saveDirectory)
+{
+	Scraper::initialize(saveDirectory);
+	directory = saveDirectory;
+	loadDat();		// no DAT yet (offline): scrape() retries
+	return true;
+}
+
+bool LibretroScraper::loadDat()
+{
+	if (!bySerial.empty())
+		return true;
+	const std::string path = directory + kDatFile;
+	std::string text;
+	if (readFile(path, text) && parseDat(text))
+		return true;
+	if (getTimeMs() < nextDatAttempt)
+		return false;
+	nextDatAttempt = getTimeMs() + 60 * 1000;
+	std::vector<u8> content;
+	std::string contentType;
+	const int status = http::get(kDatUrl, content, contentType);
+	if (!http::success(status) || content.empty())
+	{
+		WARN_LOG(COMMON, "libretro DAT download failed: %d", status);
+		return false;
+	}
+	text.assign((const char *)content.data(), content.size());
+	if (!parseDat(text))
+		return false;
+	FILE *f = nowide::fopen(path.c_str(), "wb");
+	if (f != nullptr)
+	{
+		fwrite(text.data(), 1, text.size(), f);
+		fclose(f);
+	}
+	ps4_boot_trace("covers: libretro DAT downloaded");
+	return true;
+}
+
+bool LibretroScraper::parseDat(const std::string& text)
+{
+	bySerial.clear();
+	DatGame game;
+	std::string serials, value;
+	bool inGame = false;
+	size_t pos = 0;
+	while (pos < text.size())
+	{
+		size_t end = text.find('\n', pos);
+		if (end == std::string::npos)
+			end = text.size();
+		const std::string line = text.substr(pos, end - pos);
+		pos = end + 1;
+		if (line.compare(0, 6, "game (") == 0)
+		{
+			inGame = true;
+			game = DatGame();
+			serials.clear();
+		}
+		else if (!inGame)
+			continue;
+		else if (line.size() >= 1 && line[0] == ')')
+		{
+			inGame = false;
+			if (game.name.empty())
+				continue;
+			// a few entries list several serials
+			size_t s = 0;
+			while (s <= serials.size())
+			{
+				size_t comma = serials.find(',', s);
+				if (comma == std::string::npos)
+					comma = serials.size();
+				const std::string key = normalizeSerial(serials.substr(s, comma - s));
+				if (!key.empty())
+					bySerial[key].push_back(game);
+				s = comma + 1;
+			}
+		}
+		else if (game.name.empty() && datValue(line, "name", value))
+			game.name = value;
+		else if (datValue(line, "region", value))
+			game.region = value;
+		else if (serials.empty() && datValue(line, "serial", value))
+			serials = value;
+	}
+	INFO_LOG(COMMON, "libretro DAT: %d serials", (int)bySerial.size());
+	return !bySerial.empty();
+}
+
+const LibretroScraper::DatGame *LibretroScraper::find(const std::string& serial, u32 region) const
+{
+	std::string key = normalizeSerial(serial);
+	auto it = bySerial.find(key);
+	// Sega's own discs say MK-51117 where Redump has 51117 (USA)
+	if (it == bySerial.end() && key.compare(0, 2, "MK") == 0)
+		it = bySerial.find(key.substr(2));
+	if (it == bySerial.end())
+		return nullptr;
+	for (const DatGame& g : it->second)
+		if (regionMatches(g.region, region))
+			return &g;
+	return &it->second.front();
+}
+
+void LibretroScraper::scrape(GameBoxart& item)
+{
+	if (item.scraped)
+		return;
+	if (item.arcade || item.uniqueId.empty())
+	{
+		item.scraped = true;
+		return;
+	}
+	if (!loadDat())
+		throw std::runtime_error("");	// offline: keep the item for later
+	const DatGame *game = find(item.uniqueId, item.region);
+	if (game == nullptr)
+	{
+		item.scraped = true;	// not in Redump: the disc's own image stays
+		return;
+	}
+	// the title without Redump's tags: "Sonic Adventure 2"
+	const size_t paren = game->name.find(" (");
+	item.name = game->name.substr(0, paren);
+
+	// the full Redump name, then title and region only ("... (USA) (Rev A)" is often "... (USA)")
+	std::vector<std::string> names { game->name };
+	if (paren != std::string::npos)
+	{
+		const size_t close = game->name.find(')', paren);
+		if (close != std::string::npos && close + 1 < game->name.size())
+			names.push_back(game->name.substr(0, close + 1));
+	}
+	for (const std::string& name : names)
+	{
+		const std::string url = kThumbUrl + encodePath(thumbnailName(name)) + ".png";
+		std::vector<u8> content;
+		std::string contentType;
+		const int status = http::get(url, content, contentType);
+		if (status == 404)
+			continue;
+		if (!http::success(status))
+			throw std::runtime_error("thumbnail server: HTTP " + std::to_string(status));
+		if (content.empty() || contentType.compare(0, 6, "image/") != 0)
+			continue;
+		const std::string local = makeUniqueFilename("cover.png");
+		FILE *f = nowide::fopen(local.c_str(), "wb");
+		if (f == nullptr)
+			break;
+		fwrite(content.data(), 1, content.size(), f);
+		fclose(f);
+		item.setBoxartPath(local);
+		item.boxartUrl = url;
+		break;
+	}
+	item.scraped = true;
+}
+
+namespace launcher
+{
+
+// /data/DeCast-S4/covers/<file name>.png (or .jpg), <serial>.png or <title>.png
+std::string userCover(const LauncherEntry& e)
+{
+	struct Cached { std::string path; u64 at; };
+	static std::unordered_map<std::string, Cached> cache;
+	const u64 now = getTimeMs();
+	auto it = cache.find(e.path);
+	if (it != cache.end() && now - it->second.at < 5000)
+		return it->second.path;
+
+	std::string stem = e.fileName;
+	const size_t dot = stem.find_last_of('.');
+	if (dot != std::string::npos)
+		stem = stem.substr(0, dot);
+	std::string found;
+	for (const std::string& base : { stem, e.productId, e.title })
+	{
+		if (base.empty())
+			continue;
+		for (const char *ext : { ".png", ".jpg", ".jpeg" })
+		{
+			const std::string path = kUserCovers + base + ext;
+			if (file_exists(path))
+			{
+				found = path;
+				break;
+			}
+		}
+		if (!found.empty())
+			break;
+	}
+	cache[e.path] = { found, now };
+	return found;
+}
+
+// The cover's strongest colour (by hue, weighted by saturation and brightness) as the bright
+// colour, and a deep shade of it as the dark one.
+bool paletteFromImage(const std::string& path, Color& c1, Color& c2)
+{
+	FILE *f = nowide::fopen(path.c_str(), "rb");
+	if (f == nullptr)
+		return false;
+	int w, h, n;
+	u8 *data = stbi_load_from_file(f, &w, &h, &n, 3);
+	fclose(f);
+	if (data == nullptr)
+		return false;
+	constexpr int BINS = 24;
+	float weight[BINS] {}, sr[BINS] {}, sg[BINS] {}, sb[BINS] {};
+	const int step = std::max(1, std::min(w, h) / 64);
+	for (int y = 0; y < h; y += step)
+		for (int x = 0; x < w; x += step)
+		{
+			const u8 *p = &data[(y * w + x) * 3];
+			const float r = p[0] / 255.f, g = p[1] / 255.f, b = p[2] / 255.f;
+			const float mx = std::max({ r, g, b }), mn = std::min({ r, g, b });
+			const float s = mx > 0 ? (mx - mn) / mx : 0;
+			if (s < .2f || mx < .2f)
+				continue;
+			float hue;
+			const float d = mx - mn;
+			if (mx == r) hue = std::fmod((g - b) / d, 6.f);
+			else if (mx == g) hue = (b - r) / d + 2;
+			else hue = (r - g) / d + 4;
+			hue /= 6.f;
+			if (hue < 0) hue += 1;
+			const int bin = std::min(BINS - 1, (int)(hue * BINS));
+			const float wt = s * s * mx;
+			weight[bin] += wt;
+			sr[bin] += r * wt; sg[bin] += g * wt; sb[bin] += b * wt;
+		}
+	stbi_image_free(data);
+	int best = 0;
+	for (int i = 1; i < BINS; i++)
+		if (weight[i] + .5f * (weight[(i + 1) % BINS] + weight[(i + BINS - 1) % BINS])
+				> weight[best] + .5f * (weight[(best + 1) % BINS] + weight[(best + BINS - 1) % BINS]))
+			best = i;
+	if (weight[best] <= 0.f)
+	{
+		// a grey cover: cool silver
+		c1 = { .75f, .8f, .9f };
+		c2 = { .08f, .09f, .12f };
+		return true;
+	}
+	Color c { sr[best] / weight[best], sg[best] / weight[best], sb[best] / weight[best] };
+	// bright and saturated for light, deep for the background
+	const float mx = std::max({ c.r, c.g, c.b });
+	c1 = { c.r / mx, c.g / mx, c.b / mx };
+	c1 = mix(c1, { 1, 1, 1 }, .08f);
+	c2 = { c1.r * .2f, c1.g * .2f, c1.b * .2f };
+	return true;
+}
+
+} // namespace launcher
